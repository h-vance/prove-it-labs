def read_state() -> dict:
    path = ROOT / STATE_FILENAME
    if not path.is_file():
        return {"current": None, "hints": {}, "completed": []}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        # Say so. This used to return a fresh state in silence, which meant a
        # truncated file erased every exercise the learner had completed and
        # the only sign was the list going empty. Losing the progress is
        # survivable. Losing it without a word is what made it worth changing.
        print(
            f"{YELLOW}tse: {STATE_FILENAME} could not be read and has been "
            f"reset.{OFF}\n"
            "     Progress before this point is gone. Everything else is fine.",
            file=sys.stderr,
        )
        return {"current": None, "hints": {}, "completed": []}


def write_state(state: dict) -> None:
    """Write the state file in one step rather than two.

    `write_text` truncates and then writes, so a Ctrl-C in between leaves the
    file half written and unreadable. Writing beside it and renaming means the
    file is either the old one or the new one and never neither, because rename
    within a directory is atomic.
    """
    path = ROOT / STATE_FILENAME
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n")
    os.replace(temporary, path)


def current_exercise() -> Exercise:
    state = read_state()
    if not state.get("current"):
        sys.exit("tse: no active exercise. Start one with `tse start <id>`.")
    return resolve(state["current"])


