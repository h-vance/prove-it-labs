# Stack adapters
# --------------------------------------------------------------------------- #

KIND_CLUSTER = "proveit"
KIND_CONTEXT = f"kind-{KIND_CLUSTER}"
LAB_NAMESPACE = "tse-training"
# Pre-loaded into the node so exercises start without a registry round trip,
# and so a deliberate ImagePullBackOff is the only pull failure a learner sees.
KIND_IMAGES = ["python:3.12-alpine"]


def kubectl(*args: str) -> list[str]:
    return ["kubectl", "--context", KIND_CONTEXT, *args]


def cluster_exists() -> bool:
    result = subprocess.run(["kind", "get", "clusters"], capture_output=True, text=True)
    return KIND_CLUSTER in result.stdout.split()


def node_platform() -> str | None:
    """The platform kind nodes run as, asked rather than inferred.

    A kind node is a container on the local Docker daemon, so the daemon's
    own architecture is the answer, and it already reports Go naming
    ("amd64", "arm64") which is exactly what --platform wants. Deriving this
    from `uname -m` instead means maintaining a mapping table and shipping a
    branch that only ever runs on hardware the author does not have.

    Returns None when it cannot be determined, in which case preloading is
    skipped rather than guessed at.
    """
    result = subprocess.run(
        ["docker", "version", "--format", "{{.Server.Arch}}"], capture_output=True, text=True
    )
    arch = result.stdout.strip()
    if result.returncode != 0 or not arch or "/" in arch or " " in arch:
        return None
    return f"linux/{arch}"


def image_in_node(image: str) -> bool:
    """Whether the node actually has the image, rather than whether load exited 0."""
    result = subprocess.run(
        ["docker", "exec", f"{KIND_CLUSTER}-control-plane", "crictl", "images"],
        capture_output=True,
        text=True,
    )
    repository, _, tag = image.rpartition(":")
    return any(
        repository in line and tag in line for line in result.stdout.splitlines()
    )


def preload_images() -> None:
    """Put the lab images into the node so exercises start without a pull.

    Best effort throughout. If any step fails the cluster simply pulls from the
    registry on first use, which is slower and equally correct, so nothing here
    is allowed to fail a cluster creation.
    """
    platform = node_platform()
    if platform is None:
        print(f"{DIM}Could not determine the node platform; images will be pulled on use.{OFF}")
        return

    for image in KIND_IMAGES:
        # Preloading has to go through a single-platform archive. `kind load
        # docker-image` imports with --all-platforms, which Docker's containerd
        # image store answers with a multi-arch manifest whose per-platform
        # content is not present locally, and it fails on a missing digest.
        archive = Path(tempfile.gettempdir()) / f"tse-{image.replace(':', '-').replace('/', '-')}.tar"
        steps = [
            ["docker", "pull", "-q", "--platform", platform, image],
            ["docker", "save", "--platform", platform, image, "-o", str(archive)],
            ["kind", "load", "image-archive", str(archive), "--name", KIND_CLUSTER],
        ]
        for step in steps:
            if subprocess.run(step, capture_output=True).returncode != 0:
                break
        archive.unlink(missing_ok=True)

        if image_in_node(image):
            print(f"{DIM}Preloaded {image} ({platform}).{OFF}")
        else:
            print(f"{DIM}Could not preload {image}; the cluster will pull it on first use.{OFF}")


def ensure_cluster() -> None:
    """Create the shared cluster once, then reuse it for every exercise.

    Creating a cluster per exercise would add roughly a minute to every start
    for no teaching value. The namespace is the unit that gets torn down.
    """
    if cluster_exists():
        return

    config = LABS / "kubernetes" / "_stack" / "kind-cluster.yaml"
    print(f"{DIM}Creating the {KIND_CLUSTER} cluster. This happens once and takes a minute.{OFF}")
    run(["kind", "create", "cluster", "--name", KIND_CLUSTER, "--config", str(config)])

    preload_images()


def reset_namespace() -> None:
    subprocess.run(
        kubectl("delete", "namespace", LAB_NAMESPACE, "--ignore-not-found", "--wait=true"),
        check=False,
        capture_output=True,
    )


def compose_command(exercise: Exercise) -> list[str]:
    stack = exercise.stack_dir()
    command = ["docker", "compose", "-f", str(stack / "compose.yaml")]
    override = stack / "compose.override.yaml"
    if override.is_file():
        command += ["-f", str(override)]
    return command


def managed_files(track: str) -> set[str]:
    """Every filename any exercise in this track writes into the shared stack.

    Tracked so that switching exercises cannot leave a previous exercise's
    file behind and silently change what the next one is investigating.
    """
    names: set[str] = set()
    for exercise in load_exercises():
        # Keyed on the stack source rather than the exercise's own track, or a
        # mixed incident borrowing the Docker stack would leave its files
        # behind and silently change what the next Docker exercise starts from.
        #
        # Kubernetes is excluded: its manifests are applied to a cluster and
        # stay in the exercise, so they are committed source, not generated
        # state.
        if exercise.stack_source != track or exercise.stack not in {"compose", "none"}:
            continue
        for variant in ("setup", "solution"):
            directory = exercise.path / variant
            if directory.is_dir():
                names.update(item.name for item in directory.iterdir() if item.is_file())
    return names


def provision(exercise: Exercise, *, variant: str) -> None:
    """Put the environment into the exercise's broken or fixed state.

    variant is "setup" for the state the learner investigates, or "solution"
    for the corrected state, which only `tse verify` uses.
    """
    source_dir = exercise.path / variant
    if not source_dir.is_dir():
        sys.exit(f"tse: {exercise.id} has no {variant}/ directory")

    # Before anything is copied, applied or started. Everything below this line
    # hands a contributed file to Docker or to kubectl, and a check that runs
    # afterwards is a report rather than a guard.
    check_contributed_files(source_dir, stack=exercise.stack)

    if exercise.stack == "kind":
        ensure_cluster()
        reset_namespace()
        run(kubectl("apply", "-f", str(exercise.stack_dir() / "base.yaml")))
        for manifest in sorted(source_dir.glob("*.yaml")):
            run(kubectl("apply", "-n", LAB_NAMESPACE, "-f", str(manifest)))
        return

    if exercise.stack not in {"compose", "none"}:
        sys.exit(
            f"tse: the {exercise.stack!r} stack is not implemented yet.\n"
            f"     {exercise.id} cannot be started in this phase of the course."
        )

    materialize(exercise, source_dir)

    # A "none" exercise has files but no system. Communication exercises are
    # graded on what the learner writes, so there is nothing to bring up.
    if exercise.stack == "compose":
        run(compose_command(exercise) + ["up", "-d", "--build", "--force-recreate"])


def materialize(exercise: Exercise, source_dir: Path) -> None:
    """Copy a variant's files into the shared stack, clearing prior ones first.

    Checks the files again even though `provision` already did. This is the
    function that actually writes them, so it is the one that has to be safe on
    its own: a later caller that forgets the check would otherwise reopen the
    hole silently, which is how the hole got there the first time.
    """
    check_contributed_files(source_dir, stack=exercise.stack)
    stack = exercise.stack_dir()
    stack.mkdir(parents=True, exist_ok=True)
    for name in managed_files(exercise.stack_source):
        (stack / name).unlink(missing_ok=True)
    for item in sorted(source_dir.iterdir()):
        if item.is_file():
            destination = stack / item.name
            shutil.copyfile(item, destination)
            if item.suffix == ".sh":
                destination.chmod(0o755)


def teardown(exercise: Exercise) -> None:
    if exercise.stack == "kind":
        # The namespace goes, the cluster stays. Rebuilding the cluster between
        # exercises would cost a minute each time and prove nothing.
        if cluster_exists():
            reset_namespace()
        return
    if exercise.stack not in {"compose", "none"}:
        return
    if exercise.stack == "compose":
        run(compose_command(exercise) + ["down", "--remove-orphans"], check=False)
    stack = exercise.stack_dir()
    for name in managed_files(exercise.stack_source):
        (stack / name).unlink(missing_ok=True)


def run(command: list[str], *, check: bool = True) -> int:
    sys.stdout.flush()
    result = subprocess.run(command)
    if check and result.returncode != 0:
        sys.exit(f"tse: command failed: {' '.join(command)}")
    return result.returncode


