def cmd_list(args: argparse.Namespace) -> None:
    state = read_state()
    completed = set(state.get("completed", []))
    current = state.get("current")
    exercises = load_exercises()

    if args.track:
        exercises = [e for e in exercises if e.track == args.track]

    if args.ids:
        print(json.dumps([e.id for e in exercises]))
        return

    if not exercises:
        print("No exercises found.")
        return

    track = None
    for exercise in exercises:
        if exercise.track != track:
            track = exercise.track
            print(f"\n{BOLD}{track}{OFF}")
        if exercise.id in completed:
            mark = f"{GREEN}done{OFF}"
        elif exercise.id == current:
            mark = f"{YELLOW}open{OFF}"
        else:
            mark = "    "
        tier = "" if exercise.tier == "core" else f" {DIM}[stretch]{OFF}"
        print(f"  {mark}  {exercise.id:<48} {exercise.minutes:>3}m  {exercise.title}{tier}")

    print(f"\n{len(completed)} of {len(load_exercises())} exercises completed.")


def cmd_start(args: argparse.Namespace) -> None:
    exercise = resolve(args.exercise)
    print(f"Provisioning {exercise.id} ...\n")
    provision(exercise, variant="setup")

    state = read_state()
    state["current"] = exercise.id
    state.setdefault("hints", {})[exercise.id] = 0
    write_state(state)

    print()
    print_ticket(exercise)


def print_ticket(exercise: Exercise) -> None:
    ticket = exercise.path / "ticket.md"
    if ticket.is_file():
        print(ticket.read_text().rstrip())
    print(f"\n{DIM}Gather evidence, then run `tse check`. Stuck? `tse hint`.{OFF}")


def cmd_ticket(args: argparse.Namespace) -> None:
    print_ticket(current_exercise())


def cmd_check(args: argparse.Namespace) -> None:
    exercise = resolve(args.exercise) if args.exercise else current_exercise()
    script = exercise.path / "check.sh"
    if not script.is_file():
        sys.exit(f"tse: {exercise.id} has no check.sh")

    env = os.environ.copy()
    env.update(
        TSE_ROOT=str(ROOT),
        TSE_LIB=str(LIB),
        TSE_EXERCISE_DIR=str(exercise.path),
        TSE_STACK_DIR=str(exercise.stack_dir()),
    )
    print(f"{BOLD}{exercise.id}{OFF}  {exercise.title}\n")
    result = subprocess.run(["bash", str(script)], env=env)

    if result.returncode == 0:
        state = read_state()
        completed = set(state.get("completed", []))
        if exercise.id not in completed:
            completed.add(exercise.id)
            state["completed"] = sorted(completed)
            write_state(state)
        print(f"\n{GREEN}Resolved.{OFF} Write the customer update before you move on.")
        print(f"{DIM}Compare your reasoning with `tse answer`, "
              f"then check it holds up with `tse quiz`.{OFF}")
    sys.exit(result.returncode)


def cmd_hint(args: argparse.Namespace) -> None:
    exercise = current_exercise()
    hints = sorted((exercise.path / "hints").glob("*.md")) if (exercise.path / "hints").is_dir() else []
    if not hints:
        sys.exit(f"tse: {exercise.id} has no hints. Try `tse answer`.")

    state = read_state()
    shown = int(state.get("hints", {}).get(exercise.id, 0))
    if shown >= len(hints):
        print(f"{DIM}All {len(hints)} hints shown. `tse answer` reveals the root cause.{OFF}")
        return

    print(f"{BOLD}Hint {shown + 1} of {len(hints)}{OFF}\n")
    print(hints[shown].read_text().rstrip())
    state.setdefault("hints", {})[exercise.id] = shown + 1
    write_state(state)

    remaining = len(hints) - (shown + 1)
    if remaining:
        print(f"\n{DIM}{remaining} hint(s) left. Run `tse hint` again if you need one.{OFF}")


def cmd_answer(args: argparse.Namespace) -> None:
    exercise = current_exercise()
    solution = exercise.path / "solution.md"
    if not solution.is_file():
        sys.exit(f"tse: {exercise.id} has no solution.md")
    print(solution.read_text().rstrip())


def ask_choice(count: int) -> int | None:
    """Read a 1-based answer from stdin, return it 0-based, or None at end of input.

    Returning None on EOF is what lets the smoke test drive the quiz from a
    pipe: it answers what it means to answer and then stops cleanly instead of
    spinning on an empty read.
    """
    while True:
        try:
            raw = input(f"\nYour answer [1-{count}]: ").strip()
        except EOFError:
            return None
        if raw.isdigit() and 1 <= int(raw) <= count:
            return int(raw) - 1
        print(f"{YELLOW}Enter a number from 1 to {count}.{OFF}")


def cmd_quiz(args: argparse.Namespace) -> None:
    """Check understanding once the system is fixed.

    Deliberately its own command rather than part of check.sh. `tse verify`
    runs every check non-interactively against both states in CI, so a check
    that waited for keyboard input would hang the matrix rather than fail it.
    """
    exercise = resolve(args.exercise) if args.exercise else current_exercise()
    questions = exercise.questions()
    if not questions:
        sys.exit(f"tse: {exercise.id} has no questions.json")

    print(f"{BOLD}{exercise.id}{OFF}  {exercise.title}")
    print(f"{DIM}{len(questions)} questions. Answer with the number.{OFF}")

    score = 0
    for number, question in enumerate(questions, start=1):
        options = question["options"]
        print(f"\n{BOLD}Question {number} of {len(questions)}{OFF}")
        print(f"{question['question']}\n")
        for index, option in enumerate(options, start=1):
            print(f"  {index}. {option['text']}")

        choice = ask_choice(len(options))
        if choice is None:
            print(f"\n{DIM}Stopping here. Nothing recorded.{OFF}")
            return

        chosen = options[choice]
        # A symbol as well as a color, because NO_COLOR is set on plenty of
        # terminals and "correct" must never be carried by color alone.
        if chosen.get("correct"):
            score += 1
            print(f"\n{GREEN}✓ Correct.{OFF} {chosen['explanation']}")
        else:
            answer = next(o for o in options if o.get("correct"))
            print(f"\n{RED}✗ Not quite.{OFF} {chosen['explanation']}")
            print(f"\n{BOLD}The answer: {answer['text']}{OFF}")
            print(answer["explanation"])

    total = len(questions)
    print(f"\n{BOLD}{score}/{total}{OFF}")
    if score == total:
        print(f"{GREEN}All of them.{OFF} You can explain this one, not just fix it.")
    else:
        print(f"{DIM}Re-read `tse answer` on the ones you missed, then run this again.{OFF}")

    state = read_state()
    record = state.setdefault("quiz", {})
    if score > record.get(exercise.id, {}).get("correct", -1):
        record[exercise.id] = {"correct": score, "total": total}
        write_state(state)


def private_leaks(output: str, foreign: set[str]) -> list[str]:
    """Anything in this output that belongs to the machine rather than the lab.

    Transcripts are committed and published, so the standard is that nothing
    identifying the person who recorded them can survive. This is the second
    line of defence: the first is that stored output is scrubbed, and this
    catches the categories a scrub rule would not think to look for.
    """
    found = [name for name in sorted(foreign) if name in output]

    home = str(Path.home())
    if home in output:
        found.append(home)

    user = os.environ.get("USER") or ""
    if user and re.search(rf"\b{re.escape(user)}\b", output):
        found.append(user)

    hostname = socket.gethostname()
    if hostname and hostname not in {"localhost"} and hostname in output:
        found.append(hostname)

    # Cloud account identifiers. A kubeconfig commonly holds a production
    # cluster next to the lab one, and an ARN carries an account number.
    for pattern in (r"arn:aws:\S+", r"\b\d{12}\.dkr\.ecr\b", r"\b[A-Z0-9]{20}\b"):
        found += re.findall(pattern, output)

    # Home directories from any platform, not just this one.
    found += re.findall(r"/(?:Users|home)/[A-Za-z0-9._-]+", output)

    return sorted(set(found))


def history_leaks() -> list[str]:
    """Leaks in lines this repository has ever added, not just the ones it kept.

    Deleting a secret in a later commit does not remove it from a clone, so the
    published history has to be clean too, not only the published tree. Only
    added lines are examined: a removed line was already present as an added one
    in the commit that introduced it, so scanning both would double every
    finding and make the report harder to act on.
    """
    # A shallow clone holds one commit, so this would sweep almost nothing and
    # report it as clean. actions/checkout is shallow by default, which makes
    # that the likeliest way to run it, and a vacuous pass here is worse than no
    # scan at all: it is the one result somebody would trust before going public.
    shallow = subprocess.run(
        ["git", "rev-parse", "--is-shallow-repository"],
        capture_output=True, text=True, cwd=ROOT,
    )
    if shallow.stdout.strip() == "true":
        sys.exit(
            "tse: this is a shallow clone, so scanning its history would prove nothing.\n"
            "     Run `git fetch --unshallow` first, or drop --history."
        )

    result = subprocess.run(
        ["git", "log", "-p", "--no-color", "--no-merges", "--format=commit %h"],
        capture_output=True, text=True, cwd=ROOT,
    )
    if result.returncode != 0:
        sys.exit("tse: `git log -p` failed, so the history could not be scanned.")

    findings: list[str] = []
    commit = ""
    path = ""
    for line in result.stdout.splitlines():
        if line.startswith("commit "):
            commit = line.split(maxsplit=1)[1]
        elif line.startswith("diff --git a/"):
            path = line.split(" b/", 1)[-1]
        elif line.startswith("+") and not line.startswith("+++"):
            if path in LEAK_EXEMPT:
                continue
            for _, description, matched in scan_for_leaks(line[1:], leak_patterns_for(path)):
                findings.append(f"{commit} {path}: {description}: {matched!r}")
    return findings


def cmd_leaks(args: argparse.Namespace) -> None:
    """Refuse to publish anything that describes the machine it was written on.

    The recordings have been held to this bar since they were introduced, and
    every other committed file was unchecked. This closes that half, and it runs
    on every push rather than once before the flip, because the file that leaks
    something is rarely the one anybody thought to look at.
    """
    # An exemption that outlives the file it was written for is a hole nobody
    # argued for, so renaming an exempt file has to fail rather than silently
    # exempt nothing.
    missing = [path for path in LEAK_EXEMPT if not (ROOT / path).is_file()]
    if missing:
        sys.exit(
            "tse: these paths are exempt from the leak scan but no longer exist.\n"
            "     Either restore them or remove the exemption:\n"
            + "\n".join(f"       {path}  ({LEAK_EXEMPT[path]})" for path in missing)
        )

    findings: list[str] = []
    scanned = 0
    for path in tracked_files():
        if path in LEAK_EXEMPT:
            continue
        try:
            text = (ROOT / path).read_text()
        except (UnicodeDecodeError, OSError):
            continue  # Binary or unreadable: no pattern here can read it anyway.
        scanned += 1
        for number, description, matched in scan_for_leaks(text, leak_patterns_for(path)):
            findings.append(f"{path}:{number}: {description}: {matched!r}")

    scope = f"{scanned} files"
    if args.history:
        findings += history_leaks()
        scope += " and the full history"

    if findings:
        print(f"{RED}tse: {len(findings)} things that should not be published:{OFF}\n")
        for finding in findings:
            print(f"  {finding}")
        print(
            f"\n{DIM}Each of these describes a real machine or a real credential. "
            f"Remove it, or narrow the rule if it is a false positive.{OFF}"
        )
        sys.exit(1)

    print(
        f"{GREEN}Leak scan clean.{OFF} {scope}, "
        f"{len(REPO_LEAK_PATTERNS)} patterns everywhere and "
        f"{len(TRANSCRIPT_LEAK_PATTERNS)} in recordings, "
        f"{len(LEAK_EXEMPT)} files exempt."
    )


def cmd_record(args: argparse.Namespace) -> None:
    """Capture real output for the site's terminal, or check a recording still holds.

    The terminal on the exercise page replays what these commands actually
    printed. That is only worth anything if the recording cannot drift away
    from the system, so --check re-runs everything and compares.
    """
    exercise = resolve(args.exercise)
    if exercise.stack == "none":
        sys.exit(f"tse: {exercise.id} has no system, so there is nothing to record.")

    source = exercise.path / "commands.txt"
    if not source.is_file():
        sys.exit(f"tse: {exercise.id} has no commands.txt")
    blocks = parse_commands(source.read_text())
    if not blocks:
        sys.exit(f"tse: {exercise.id} has an empty commands.txt")

    transcript_path = exercise.path / "transcript.json"
    previous: dict | None = None
    if args.check:
        if not transcript_path.is_file():
            sys.exit(f"tse: {exercise.id} has no transcript.json to check against")
        previous = json.loads(transcript_path.read_text())

    # Recorded commands run through `bash -c` exactly as a learner would type
    # them, which means a Kubernetes exercise runs against whatever context
    # happens to be current. Plenty of people have a production cluster in
    # their kubeconfig, so this refuses rather than pointing lab commands at
    # something real. tse's own calls always pass --context and were never at
    # risk; the commands in commands.txt are.
    if exercise.stack == "kind":
        current = subprocess.run(
            ["kubectl", "config", "current-context"], capture_output=True, text=True,
        ).stdout.strip()
        if current != KIND_CONTEXT:
            sys.exit(
                f"tse: the current kubectl context is {current or 'unset'!r}, "
                f"not {KIND_CONTEXT!r}.\n"
                f"     Recorded commands run against the current context, so this "
                f"would capture\n     output from the wrong cluster. Switch with:\n"
                f"       kubectl config use-context {KIND_CONTEXT}"
            )

    foreign = foreign_projects()
    print(f"{BOLD}{exercise.id}{OFF}  {'checking' if args.check else 'recording'} "
          f"{len(blocks)} command(s)\n")

    entries: list[dict] = []
    problems: list[str] = []
    missing: dict[str, list[str]] = {}
    try:
        provision(exercise, variant="setup")
        for block in blocks:
            if block["wait"]:
                time.sleep(block["wait"])
            captured, code = run_for_record(block["command"])
            label = normalize_command(block["command"])[:70]

            # Store the scrubbed form, not what was captured.
            #
            # These files are committed and published. Raw output carries the
            # ids, addresses and clock of the machine that happened to run the
            # recording, and none of that belongs to the course. Scrubbing at
            # write time means the values that differ per machine are shown as
            # placeholders, which is also more honest for the reader: it marks
            # exactly which parts of the output are theirs rather than mine.
            output = scrub(captured, privacy_only=True)

            leaked = private_leaks(output, foreign)
            if leaked:
                problems.append(
                    f"{label}\n      names something outside the lab: {leaked}.\n"
                    f"      Scope the command, for example filter by the compose "
                    f"project, so the recording contains only this exercise."
                )
                continue

            entry = {
                "command": block["command"],
                "aliases": block["aliases"],
                "output": output,
                "exit": code,
            }
            entry_missing = [m for m in block["keep"] if m not in output]
            entries.append(entry)
            missing[block["command"]] = entry_missing
            if entry_missing:
                print(f"  {RED}lost{OFF}  {label}")
            else:
                print(f"  {GREEN}ok{OFF}    {label}")
    finally:
        teardown(exercise)

    if problems:
        print(f"\n{RED}{len(problems)} command(s) cannot be recorded:{OFF}")
        for problem in problems:
            print(f"  {problem}")
        sys.exit(1)

    if args.check:
        # Compare before diagnosing missing markers. A changed system and an
        # over-broad scrub rule both lose a marker, and only the comparison
        # tells them apart. Reporting "a rule is too broad" when the truth is
        # "the system changed" sends the reader to the wrong file.
        drifted = compare_transcript(previous or {}, entries)
        if drifted:
            print(f"\n{RED}The recording no longer matches the system.{OFF}")
            for line in drifted:
                print(f"  {line}")
            print(f"\nRe-record with `tse record {exercise.id}` once you have "
                  f"confirmed the change is intended.")
            sys.exit(1)
        if any(missing.values()):
            print(f"\n{RED}The output is unchanged, so a scrub rule has grown "
                  f"too broad and is erasing evidence:{OFF}")
            for command, markers in missing.items():
                if markers:
                    print(f"  {normalize_command(command)[:70]}\n      lost {markers}")
            sys.exit(1)
        print(f"\n{GREEN}{exercise.id}: the recording still matches.{OFF}")
        return

    if any(missing.values()):
        print(f"\n{RED}Evidence did not survive scrubbing:{OFF}")
        for command, markers in missing.items():
            if markers:
                print(f"  {normalize_command(command)[:70]}\n      lost {markers}")
        print("\nEither the system is not in the state the exercise describes, "
              "or a scrub rule is too broad.")
        sys.exit(1)

    if len(entries) < 4:
        print(f"\n{YELLOW}Only {len(entries)} command(s) recorded.{OFF} A thin "
              f"transcript makes the terminal frustrating rather than useful.")

    transcript_path.write_text(
        json.dumps({"recorded": date.today().isoformat(), "entries": entries}, indent=2) + "\n"
    )
    print(f"\n{GREEN}Wrote {transcript_path.relative_to(ROOT)}{OFF}")


def compare_transcript(previous: dict, fresh: list[dict]) -> list[str]:
    """Differences that survive scrubbing, which are the ones that mean something."""
    before = previous.get("entries", [])
    if len(before) != len(fresh):
        return [f"the recording has {len(before)} command(s), the run produced {len(fresh)}"]

    differences: list[str] = []
    for old, new in zip(before, fresh):
        label = normalize_command(new["command"])[:70]
        if normalize_command(old.get("command", "")) != normalize_command(new["command"]):
            differences.append(f"{label}\n      commands.txt changed since the recording")
            continue
        if old.get("exit") != new["exit"]:
            differences.append(
                f"{label}\n      exited {new['exit']}, the recording has {old.get('exit')}"
            )
        if scrub(old.get("output", "")) != scrub(new["output"]):
            differences.append(f"{label}\n      output changed" + first_difference(
                scrub(old.get("output", "")), scrub(new["output"])
            ))
    return differences


def first_difference(before: str, after: str) -> str:
    """The first line that differs, which is usually enough to see what moved."""
    old_lines, new_lines = before.split("\n"), after.split("\n")
    for index in range(max(len(old_lines), len(new_lines))):
        old = old_lines[index] if index < len(old_lines) else "<nothing>"
        new = new_lines[index] if index < len(new_lines) else "<nothing>"
        if old != new:
            return f" at line {index + 1}:\n        recorded: {old}\n        now:      {new}"
    return ""


def cmd_apply(args: argparse.Namespace) -> None:
    """Recreate the services from the learner's edited configuration."""
    exercise = current_exercise()
    if exercise.stack == "none":
        sys.exit(
            "tse: this exercise has no system to apply to.\n"
            "     Edit the file named in the ticket, then run `tse check`."
        )
    if exercise.stack == "kind":
        sys.exit(
            "tse: the Kubernetes track has no apply step.\n"
            "     Change the cluster directly, the way you would in production:\n"
            f"       kubectl -n {LAB_NAMESPACE} edit deployment/<name>\n"
            f"       kubectl -n {LAB_NAMESPACE} set image ...\n"
            "     Then run `tse check`."
        )
    if exercise.stack != "compose":
        sys.exit(f"tse: apply is not used by the {exercise.stack!r} stack")
    run(compose_command(exercise) + ["up", "-d", "--build", "--force-recreate"])
    print(f"\n{DIM}Applied. Now prove it worked with `tse check`.{OFF}")


def cmd_reset(args: argparse.Namespace) -> None:
    exercise = current_exercise()
    print(f"Resetting {exercise.id} ...")
    provision(exercise, variant="setup")
    state = read_state()
    state.setdefault("hints", {})[exercise.id] = 0
    write_state(state)
    print("Back to the state described in the ticket.")


def cmd_stop(args: argparse.Namespace) -> None:
    exercise = current_exercise()
    teardown(exercise)
    state = read_state()
    state["current"] = None
    write_state(state)
    print(f"Stopped {exercise.id}.")


def cmd_cluster(args: argparse.Namespace) -> None:
    if args.action == "up":
        ensure_cluster()
        print(f"{GREEN}Cluster {KIND_CLUSTER} is ready.{OFF}")
    elif args.action == "down":
        if not cluster_exists():
            print(f"Cluster {KIND_CLUSTER} does not exist.")
            return
        run(["kind", "delete", "cluster", "--name", KIND_CLUSTER])
    else:
        if not cluster_exists():
            print(f"Cluster {KIND_CLUSTER} does not exist. Create it with `tse cluster up`.")
            return
        print(f"{GREEN}Cluster {KIND_CLUSTER} exists.{OFF}")
        platform = node_platform()
        for image in KIND_IMAGES:
            state = "preloaded" if image_in_node(image) else "will be pulled on use"
            print(f"  {image:<24} {state}")
        print(f"  node platform            {platform or 'unknown'}\n")
        subprocess.run(kubectl("get", "nodes"), check=False)
        subprocess.run(kubectl("get", "all", "-n", LAB_NAMESPACE), check=False)


def cmd_progress(args: argparse.Namespace) -> None:
    state = read_state()
    exercises = load_exercises()
    completed = set(state.get("completed", []))
    payload = {
        "completed": sorted(completed),
        "total": len(exercises),
        "by_track": {},
    }
    for exercise in exercises:
        bucket = payload["by_track"].setdefault(exercise.track, {"done": 0, "total": 0})
        bucket["total"] += 1
        if exercise.id in completed:
            bucket["done"] += 1

    if args.json:
        print(json.dumps(payload, indent=2))
        return

    for track, counts in payload["by_track"].items():
        bar_width = 24
        filled = round(bar_width * counts["done"] / counts["total"]) if counts["total"] else 0
        bar = "#" * filled + "." * (bar_width - filled)
        print(f"  {track:<16} {bar}  {counts['done']}/{counts['total']}")
    print(f"\n  {BOLD}{len(completed)}/{len(exercises)}{OFF} overall")
    print(f"\n{DIM}Export for the site with `tse progress --json`.{OFF}")


def cmd_doctor(args: argparse.Namespace) -> None:
    checks: list[tuple[str, bool, str]] = []

    def probe(label: str, command: list[str], remedy: str) -> None:
        binary = shutil.which(command[0])
        if not binary:
            checks.append((label, False, remedy))
            return
        result = subprocess.run(command, capture_output=True, text=True)
        detail = (result.stdout or result.stderr).strip().splitlines()
        checks.append((label, result.returncode == 0, detail[0] if detail else ""))

    probe("docker", ["docker", "--version"], "Install Docker, or open this repo in a Codespace.")
    probe("docker compose", ["docker", "compose", "version"], "Docker Compose v2 is required.")
    probe("docker daemon", ["docker", "info", "--format", "{{.ServerVersion}}"], "Start Docker.")
    probe("kubectl", ["kubectl", "version", "--client=true", "-o", "yaml"], "Needed for the Kubernetes track.")
    probe("kind", ["kind", "version"], "Needed for the Kubernetes track.")
    probe("curl", ["curl", "--version"], "Needed by most checks.")
    probe("jq", ["jq", "--version"], "Needed by the API and observability tracks.")

    cpus = os.cpu_count() or 1
    checks.append((
        f"cpu cores ({cpus})",
        cpus >= 4,
        "The Kubernetes track needs 4 cores. Use a 4-core Codespace." if cpus < 4 else "",
    ))

    width = max(len(label) for label, _, _ in checks)
    failures = 0
    for label, ok, detail in checks:
        if ok:
            print(f"  {GREEN}ok{OFF}    {label:<{width}}  {DIM}{detail}{OFF}")
        else:
            failures += 1
            print(f"  {RED}warn{OFF}  {label:<{width}}  {detail}")

    print()
    if failures:
        print(f"{YELLOW}{failures} check(s) need attention.{OFF} "
              "Docker tracks work as long as docker and curl are ok.")
    else:
        print(f"{GREEN}Environment ready.{OFF} Start with `tse start docker/01`.")


def run_check(exercise: Exercise, *, max_retries: int | None = None) -> int:
    env = os.environ.copy()
    env.update(
        TSE_ROOT=str(ROOT),
        TSE_LIB=str(LIB),
        TSE_EXERCISE_DIR=str(exercise.path),
        TSE_STACK_DIR=str(exercise.stack_dir()),
    )
    if max_retries is not None:
        env["TSE_MAX_RETRIES"] = str(max_retries)
    sys.stdout.flush()
    return subprocess.run(["bash", str(exercise.path / "check.sh")], env=env).returncode


def verify_one(exercise: Exercise) -> bool:
    """An exercise is only correct if it fails broken and passes fixed."""
    print(f"\n{BOLD}=== {exercise.id} ==={OFF}\n")
    ok = True
    try:
        print(f"{DIM}-- broken state: check must fail --{OFF}\n")
        provision(exercise, variant="setup")
        if run_check(exercise, max_retries=3) == 0:
            print(f"{RED}BROKEN STATE PASSED.{OFF} The exercise is not actually broken, "
                  f"or check.sh does not assert the failure.")
            ok = False

        print(f"\n{DIM}-- fixed state: check must pass --{OFF}\n")
        provision(exercise, variant="solution")
        if run_check(exercise) != 0:
            print(f"{RED}FIXED STATE FAILED.{OFF} The documented solution does not "
                  f"satisfy check.sh.")
            ok = False
    finally:
        teardown(exercise)

    print(f"\n{GREEN if ok else RED}{exercise.id}: {'verified' if ok else 'INVALID'}{OFF}")
    return ok


def cmd_verify(args: argparse.Namespace) -> None:
    if args.exercise:
        targets = [resolve(args.exercise)]
    else:
        # Every exercise is verifiable, including the ones with no system.
        # A communication exercise still has a broken draft that must fail
        # the rubric and a good one that must pass it.
        targets = load_exercises()

    failed = [e.id for e in targets if not verify_one(e)]

    print()
    if failed:
        print(f"{RED}{len(failed)} exercise(s) invalid:{OFF}")
        for exercise_id in failed:
            print(f"  {exercise_id}")
        sys.exit(1)
    print(f"{GREEN}All {len(targets)} exercise(s) verified.{OFF}")


def cmd_new(args: argparse.Namespace) -> None:
    try:
        track, slug = args.exercise.split("/", 1)
    except ValueError:
        sys.exit("tse: expected <track>/<slug>, for example `tse new docker/04-port-mapping`")

    destination = LABS / track / slug
    if destination.exists():
        sys.exit(f"tse: {destination.relative_to(ROOT)} already exists")
    if not (TEMPLATES / "exercise").is_dir():
        sys.exit("tse: tools/templates/exercise is missing")

    shutil.copytree(TEMPLATES / "exercise", destination)
    meta_path = destination / "meta.yaml"
    meta_path.write_text(
        meta_path.read_text()
        .replace("{{TRACK}}", track)
        .replace("{{SLUG}}", slug)
    )
    (destination / "check.sh").chmod(0o755)
    print(f"Created {destination.relative_to(ROOT)}")
    print("Next: write ticket.md as a symptom only, then setup/, check.sh, hints/, solution.md")


def main() -> None:
    parser = argparse.ArgumentParser(prog="tse", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("list", help="show every exercise and your progress")
    p.add_argument("--track", help="limit to one track")
    p.add_argument("--ids", action="store_true", help="emit a JSON array of ids for CI")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("verify", help="assert an exercise fails broken and passes fixed")
    p.add_argument("exercise", nargs="?", help="omit to verify every exercise")
    p.set_defaults(func=cmd_verify)

    p = sub.add_parser("start", help="provision an exercise and print its ticket")
    p.add_argument("exercise")
    p.set_defaults(func=cmd_start)

    p = sub.add_parser("ticket", help="reprint the active ticket")
    p.set_defaults(func=cmd_ticket)

    p = sub.add_parser("check", help="grade the active exercise, showing the evidence used")
    p.add_argument("exercise", nargs="?")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("hint", help="reveal the next hint")
    p.set_defaults(func=cmd_hint)

    p = sub.add_parser("answer", help="reveal the root cause and the customer wording")
    p.set_defaults(func=cmd_answer)

    p = sub.add_parser("quiz", help="answer the exercise's questions and see why")
    p.add_argument("exercise", nargs="?")
    p.set_defaults(func=cmd_quiz)

    p = sub.add_parser("record", help="capture real output for the site's terminal")
    p.add_argument("exercise")
    p.add_argument("--check", action="store_true",
                   help="re-run and assert the recording still matches the system")
    p.set_defaults(func=cmd_record)

    p = sub.add_parser("leaks", help="scan committed files for anything from a real machine")
    p.add_argument("--history", action="store_true",
                   help="also scan every line this repository has ever added")
    p.set_defaults(func=cmd_leaks)

    p = sub.add_parser("apply", help="recreate the services after you edit the configuration")
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("reset", help="return to the state described in the ticket")
    p.set_defaults(func=cmd_reset)

    p = sub.add_parser("stop", help="tear down the active exercise")
    p.set_defaults(func=cmd_stop)

    p = sub.add_parser("progress", help="show or export progress")
    p.add_argument("--json", action="store_true", help="emit JSON for the site to import")
    p.set_defaults(func=cmd_progress)

    p = sub.add_parser("cluster", help="manage the shared Kubernetes lab cluster")
    p.add_argument("action", choices=["up", "down", "status"], nargs="?", default="status")
    p.set_defaults(func=cmd_cluster)

    p = sub.add_parser("doctor", help="verify this machine can run the labs")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("new", help="scaffold a new exercise from the template")
    p.add_argument("exercise", help="<track>/<slug>")
    p.set_defaults(func=cmd_new)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
