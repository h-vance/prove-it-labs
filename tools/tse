# --------------------------------------------------------------------------- #
# What an exercise is allowed to contribute
#
# An exercise describes a broken system by dropping files into a shared stack,
# which `provision` then hands to Docker or to kubectl. That is the whole design
# and it is a good one, but it means the exercise, not the stack, has the last
# word on what runs.
#
# While this repository had one author that was a private matter. The moment it
# is public and takes pull requests it stops being one: `verify.yml` provisions
# every exercise it discovers on a branch, so a contributed file is executed by
# CI before any human reads it. An audit proved the consequence rather than
# assuming it, by rendering the merged configuration a contributed
# compose.override.yaml produces. It carried `privileged: true` and a bind mount
# of `/` into the container, and every hardening flag the stack declares was
# gone.
#
# So the stack now keeps the last word. Three rules, each narrow enough to state
# in one line, and each enforced here rather than only in a test, because
# provisioning happens before any test could intervene.
# --------------------------------------------------------------------------- #

# Rule one: an exercise may only write a filename the stack is declared to
# generate. Every name here appears in .gitignore under labs/*/_stack/, and a
# test asserts the two lists still agree, so this cannot drift into a list that
# permits a file the repository also tracks. That is what protects compose.yaml,
# the Dockerfiles and the service source: they are committed, so they are not
# here, so an exercise cannot replace them.
#
# Adding a name is a deliberate one-line change. That friction is the point.
CONTRIBUTABLE_FILENAMES = {
    "compose.override.yaml",
    "request.sh",
    "query.sql",
    "tenants.json",
    "customer-update.md",
    "escalation.md",
    "evidence.md",
}

# Rule two: an override may only reach the keys the exercises actually use.
#
# Exactly four, counted across all twenty override files in the repository:
# environment, user, group_add and ports. Nothing is listed here on the grounds
# that it might be wanted later. A fifth key costs one line and a moment's
# thought about whether it can be used to leave the container, which is the
# thought this list exists to force.
COMPOSE_OVERRIDE_KEYS = {"environment", "user", "group_add", "ports"}

# Compose's own merge tags. `ports: !override` is used by mixed/01 to replace
# the list rather than append to it. Any other tag is refused, because a tag is
# an instruction to the parser and this scan is not a parser.
COMPOSE_TAGS = {"!override", "!reset"}

# Rule three: a manifest may only create the kinds the track teaches with, and
# may not ask for anything that reaches the node.
#
# Every contributed manifest in the repository is a Deployment or a Service.
# ConfigMap and Namespace live in the committed base.yaml, which is not
# contributed and is not checked here.
KUBERNETES_KINDS = {"Deployment", "Service", "ConfigMap"}

# Fields that cross the boundary between the pod and the machine underneath it.
# Matched as keys anywhere in the document rather than by path, because the
# point is that none of them belong in a lab manifest at any depth.
KUBERNETES_FORBIDDEN_FIELDS = {
    "hostPath", "hostNetwork", "hostPID", "hostIPC", "hostPort", "hostUsers",
    "privileged", "allowPrivilegeEscalation", "nodeName", "hostAliases",
}


def check_compose_override(text: str, source: str) -> None:
    """Refuse an override that reaches past the keys exercises use.

    A deliberately small scan rather than a YAML parse, and strict about what it
    will look at: two space indents, block style only, no flow mappings, no tags
    beyond compose's own merge tags. Anything it cannot read confidently it
    refuses, because the failure it exists to prevent is one where something
    unreadable is waved through.
    """
    services_seen = False
    for number, raw in enumerate(text.splitlines(), start=1):
        where = f"{source}:{number}"
        if "\t" in raw:
            sys.exit(f"tse: {where}: tabs are not valid YAML indentation.")
        line = raw.split("#", 1)[0].rstrip()
        if not line.strip():
            continue

        indent = len(line) - len(line.lstrip(" "))
        if indent % 2:
            sys.exit(f"tse: {where}: indentation must be a multiple of two spaces.")
        body = line.strip()
        # Anywhere on the line, not only at the start of one. `services: {app:
        # {privileged: true}}` is a single line whose first word is the one key
        # this scan expects, and an earlier version of this check waved it
        # through for exactly that reason. No real override in the repository
        # contains either character, so refusing both outright costs nothing.
        if "{" in body or "[" in body:
            sys.exit(
                f"tse: {where}: flow style is not accepted in an override.\n"
                "     Write it as an indented block so it can be checked."
            )

        for word in body.split():
            if word.startswith("!") and word not in COMPOSE_TAGS:
                sys.exit(f"tse: {where}: unknown YAML tag {word!r}.")

        if indent == 0:
            key, _, value = body.partition(":")
            key = key.strip()
            if key != "services":
                sys.exit(
                    f"tse: {where}: an override may only define `services`, not {key!r}."
                )
            if value.strip():
                sys.exit(
                    f"tse: {where}: `services` must open a block, not carry a value."
                )
            services_seen = True
        elif indent == 4:
            # A service's own keys. Two deeper than `services`, one deeper than
            # the service name. List items belong to the key above them.
            if body.startswith("- "):
                continue
            key = body.split(":", 1)[0].strip()
            if key not in COMPOSE_OVERRIDE_KEYS:
                sys.exit(
                    f"tse: {where}: an override may not set {key!r}.\n"
                    f"     Allowed: {', '.join(sorted(COMPOSE_OVERRIDE_KEYS))}.\n"
                    "     The stack declares how its containers are confined and an\n"
                    "     exercise does not get to change that."
                )

    if not services_seen:
        sys.exit(f"tse: {source}: no `services` block, so there is nothing to apply.")


# --------------------------------------------------------------------------- #
# What a stack promises about its own containment
# --------------------------------------------------------------------------- #

# CONTRIBUTING tells a contributor to copy these from an existing stack. Nothing
# checked that they did, and an audit found the answer: the one image in the
# course that holds data, postgres, was running with full capabilities in both
# stacks that use it while every Python service beside it was sealed.
CONTAINMENT_KEYS = ("read_only", "cap_drop", "security_opt",
                    "mem_limit", "cpus", "pids_limit")

# A service that genuinely cannot take one of these says so here, in the compose
# file, with the reason. Compose ignores any key starting with `x-`, so this
# costs nothing at runtime and cannot be forgotten in a comment somewhere else.
CONTAINMENT_EXCEPTION = "x-containment"


def service_containment(text: str, source: str) -> dict[str, dict[str, str]]:
    """Which containment keys each service in a compose file ends up with.

    A scan rather than a YAML parse, matching `check_compose_override` above,
    and strict for the same reason: what it cannot read confidently it refuses,
    because a containment check that silently reads nothing reports a sealed
    stack either way.

    Merge keys are resolved, because the observability stack defines its
    posture once in an anchor and shares it across three services. Values are
    returned as text: a list becomes its items joined by commas, which is all
    any caller here needs to ask about.
    """
    lines = text.splitlines()
    blocks: dict[str, dict[str, str]] = {}   # anchor name or service -> keys
    anchors: dict[str, str] = {}             # anchor name -> block name
    merges: dict[str, list[str]] = {}        # service -> anchor names it merges
    order: list[str] = []                    # service names, in file order

    current: str | None = None
    body_indent = 0
    key: str | None = None
    in_services = False

    for number, raw in enumerate(lines, start=1):
        where = f"{source}:{number}"
        if "\t" in raw:
            sys.exit(f"tse: {where}: tabs are not valid YAML indentation.")
        line = raw.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(" "))
        if indent % 2:
            sys.exit(f"tse: {where}: indentation must be a multiple of two spaces.")
        body = line.strip()

        # A top level key ends whatever block was open.
        if indent == 0:
            current, key = None, None
            in_services = body.startswith("services:")
            name, _, rest = body.partition(":")
            marker = rest.strip()
            if marker.startswith("&"):
                # An anchored mapping at the root, such as `x-service: &service`.
                current = name.strip()
                anchors[marker[1:].split()[0]] = current
                blocks[current] = {}
                body_indent = 2
            continue

        if in_services and indent == 2 and body.endswith(":"):
            current = body[:-1].strip()
            blocks.setdefault(current, {})
            merges.setdefault(current, [])
            order.append(current)
            body_indent = 4
            key = None
            continue

        if current is None:
            continue

        if indent == body_indent:
            name, _, value = body.partition(":")
            key = name.strip()
            value = value.strip()
            if key == "<<":
                if not value.startswith("*"):
                    sys.exit(f"tse: {where}: a merge key must name an anchor.")
                merges.setdefault(current, []).append(value[1:].split()[0])
                key = None
                continue
            blocks[current][key] = value
        elif indent > body_indent and body.startswith("- ") and key:
            # A list item belonging to the key above it.
            item = body[2:].strip()
            existing = blocks[current][key]
            blocks[current][key] = f"{existing}, {item}" if existing else item

    resolved: dict[str, dict[str, str]] = {}
    for service in order:
        merged: dict[str, str] = {}
        for anchor in merges.get(service, []):
            if anchor not in anchors:
                sys.exit(f"tse: {source}: `{service}` merges *{anchor}, which is not defined.")
            merged.update(blocks[anchors[anchor]])
        merged.update(blocks[service])
        resolved[service] = merged
    return resolved


def check_kubernetes_manifest(text: str, source: str) -> None:
    """Refuse a manifest that creates an unexpected kind or reaches the node."""
    kinds = re.findall(r"(?m)^\s*kind:\s*(\S+)", text)
    if not kinds:
        sys.exit(f"tse: {source}: no `kind`, so this is not a manifest.")
    for kind in kinds:
        if kind.strip("\"'") not in KUBERNETES_KINDS:
            sys.exit(
                f"tse: {source}: {kind} is not a kind the labs create.\n"
                f"     Allowed: {', '.join(sorted(KUBERNETES_KINDS))}."
            )
    for number, raw in enumerate(text.splitlines(), start=1):
        key = raw.split("#", 1)[0].split(":", 1)[0].strip().lstrip("- ")
        if key in KUBERNETES_FORBIDDEN_FIELDS:
            sys.exit(
                f"tse: {source}:{number}: {key} reaches the machine the pod runs on.\n"
                "     A lab manifest has no reason to, so this is refused."
            )


def check_contributed_files(source_dir: Path, *, stack: str) -> None:
    """Check every file an exercise variant is about to hand to the system."""
    for item in sorted(source_dir.iterdir()):
        if not item.is_file():
            sys.exit(f"tse: {item.relative_to(ROOT)} is not a file.")
        where = str(item.relative_to(ROOT))

        if stack == "kind":
            if item.suffix != ".yaml":
                continue
            check_kubernetes_manifest(item.read_text(), where)
            continue

        if item.name not in CONTRIBUTABLE_FILENAMES:
            sys.exit(
                f"tse: {where}: an exercise may not contribute a file named "
                f"{item.name!r}.\n"
                f"     Allowed: {', '.join(sorted(CONTRIBUTABLE_FILENAMES))}."
            )
        if item.name == "compose.override.yaml":
            check_compose_override(item.read_text(), where)


# --------------------------------------------------------------------------- #
# Metadata parsing
#
# tse deliberately has no third-party dependencies. On a modern Mac or Linux
# box `pip install` into the system interpreter is refused (PEP 668), and a
# course whose premise is "no setup friction" cannot open with a broken install
# step. meta.yaml therefore uses a documented YAML subset that the standard
# library can parse: scalars, flat lists, and folded block strings. PyYAML is
# used instead when it happens to be available.
# --------------------------------------------------------------------------- #

def _coerce(value: str):
    text = value.strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        return text[1:-1]
    if text in {"true", "True"}:
        return True
    if text in {"false", "False"}:
        return False
    if text in {"null", "~", ""}:
        return None
    try:
        return int(text)
    except ValueError:
        return text


def _indent_of(line: str) -> int:
    return len(line) - len(line.lstrip(" "))


def parse_meta(text: str, source: str) -> dict:
    """Parse a meta.yaml. Uses PyYAML when installed, the subset parser otherwise."""
    try:
        import yaml  # noqa: PLC0415 - optional, used only when installed
    except ImportError:
        return parse_meta_subset(text, source)
    return yaml.safe_load(text) or {}


def parse_meta_subset(text: str, source: str) -> dict:
    """Parse the documented meta.yaml subset. Raises on anything outside it.

    Kept importable on its own so the test suite can assert it agrees with a
    real YAML parser, which is what makes the no-dependency trade safe.
    """
    lines = text.splitlines()
    result: dict = {}
    index = 0

    while index < len(lines):
        raw = lines[index]
        stripped = raw.strip()
        index += 1

        if not stripped or stripped.startswith("#"):
            continue
        if _indent_of(raw) != 0:
            raise ValueError(f"{source}: unexpected indentation at line {index}: {raw!r}")
        if ":" not in stripped:
            raise ValueError(f"{source}: expected 'key: value' at line {index}: {raw!r}")

        key, _, inline = stripped.partition(":")
        key = key.strip()
        inline = inline.strip()

        if inline.startswith("#"):
            inline = ""
        elif " #" in inline and not inline.startswith(("\"", "'")):
            inline = inline.split(" #", 1)[0].strip()

        if inline in {">", "|", ">-", "|-"}:
            block: list[str] = []
            while index < len(lines) and (not lines[index].strip() or _indent_of(lines[index]) > 0):
                block.append(lines[index].strip())
                index += 1
            joiner = " " if inline.startswith(">") else "\n"
            folded = joiner.join(part for part in block if part)
            # YAML's default chomping is "clip": a block scalar keeps exactly one
            # trailing newline, and only the "-" forms strip it. Omitting that
            # newline is invisible in rendered output and still a divergence
            # from every real YAML parser, including the one the site uses.
            result[key] = folded if inline.endswith("-") else folded + "\n"
            continue

        if inline.startswith("[") and inline.endswith("]"):
            body = inline[1:-1].strip()
            result[key] = [_coerce(item) for item in body.split(",")] if body else []
            continue

        if inline:
            result[key] = _coerce(inline)
            continue

        items: list = []
        while index < len(lines):
            candidate = lines[index]
            if not candidate.strip():
                index += 1
                continue
            if _indent_of(candidate) == 0:
                break
            entry = candidate.strip()
            if not entry.startswith("- "):
                raise ValueError(
                    f"{source}: nested mappings are not supported at line {index + 1}: "
                    f"{candidate!r}"
                )
            items.append(_coerce(entry[2:]))
            index += 1
        # A key with nothing under it is null, not an empty list. An empty list
        # can only be written as [], which the inline branch above handles.
        result[key] = items if items else None

    return result


