def repo_root() -> Path:
    for candidate in [Path(__file__).resolve().parent, *Path(__file__).resolve().parents]:
        if (candidate / "labs").is_dir() and (candidate / "tools").is_dir():
            return candidate
    sys.exit("tse: could not locate the repository root (no labs/ and tools/ found).")


