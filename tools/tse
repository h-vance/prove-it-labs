# --------------------------------------------------------------------------- #
# Metadata parsing
#
# tse deliberately has no third-party dependencies. On a modern Mac or Linux
# box `pip install` into the system interpreter is refused (PEP 668), and a
# course whose premise is "no setup friction" cannot open with a broken install
# step. meta.yaml therefore uses a documented YAML subset that the standard
# library can parse: scalars, flat lists, and folded block strings. PyYAML is
# used instead when it happens to be available.
# --------------------------------------------------------------------------- #

def _coerce(value: str):
    text = value.strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        return text[1:-1]
    if text in {"true", "True"}:
        return True
    if text in {"false", "False"}:
        return False
    if text in {"null", "~", ""}:
        return None
    try:
        return int(text)
    except ValueError:
        return text


def _indent_of(line: str) -> int:
    return len(line) - len(line.lstrip(" "))


def parse_meta(text: str, source: str) -> dict:
    """Parse a meta.yaml. Uses PyYAML when installed, the subset parser otherwise."""
    try:
        import yaml  # noqa: PLC0415 - optional, used only when installed
    except ImportError:
        return parse_meta_subset(text, source)
    return yaml.safe_load(text) or {}


def parse_meta_subset(text: str, source: str) -> dict:
    """Parse the documented meta.yaml subset. Raises on anything outside it.

    Kept importable on its own so the test suite can assert it agrees with a
    real YAML parser, which is what makes the no-dependency trade safe.
    """
    lines = text.splitlines()
    result: dict = {}
    index = 0

    while index < len(lines):
        raw = lines[index]
        stripped = raw.strip()
        index += 1

        if not stripped or stripped.startswith("#"):
            continue
        if _indent_of(raw) != 0:
            raise ValueError(f"{source}: unexpected indentation at line {index}: {raw!r}")
        if ":" not in stripped:
            raise ValueError(f"{source}: expected 'key: value' at line {index}: {raw!r}")

        key, _, inline = stripped.partition(":")
        key = key.strip()
        inline = inline.strip()

        if inline.startswith("#"):
            inline = ""
        elif " #" in inline and not inline.startswith(("\"", "'")):
            inline = inline.split(" #", 1)[0].strip()

        if inline in {">", "|", ">-", "|-"}:
            block: list[str] = []
            while index < len(lines) and (not lines[index].strip() or _indent_of(lines[index]) > 0):
                block.append(lines[index].strip())
                index += 1
            joiner = " " if inline.startswith(">") else "\n"
            folded = joiner.join(part for part in block if part)
            # YAML's default chomping is "clip": a block scalar keeps exactly one
            # trailing newline, and only the "-" forms strip it. Omitting that
            # newline is invisible in rendered output and still a divergence
            # from every real YAML parser, including the one the site uses.
            result[key] = folded if inline.endswith("-") else folded + "\n"
            continue

        if inline.startswith("[") and inline.endswith("]"):
            body = inline[1:-1].strip()
            result[key] = [_coerce(item) for item in body.split(",")] if body else []
            continue

        if inline:
            result[key] = _coerce(inline)
            continue

        items: list = []
        while index < len(lines):
            candidate = lines[index]
            if not candidate.strip():
                index += 1
                continue
            if _indent_of(candidate) == 0:
                break
            entry = candidate.strip()
            if not entry.startswith("- "):
                raise ValueError(
                    f"{source}: nested mappings are not supported at line {index + 1}: "
                    f"{candidate!r}"
                )
            items.append(_coerce(entry[2:]))
            index += 1
        # A key with nothing under it is null, not an empty list. An empty list
        # can only be written as [], which the inline branch above handles.
        result[key] = items if items else None

    return result


# --------------------------------------------------------------------------- #
# Model
# --------------------------------------------------------------------------- #

@dataclass(frozen=True)
class Exercise:
    id: str
    path: Path
    meta: dict

    @property
    def track(self) -> str:
        return self.meta.get("track", self.id.split("/")[0])

    @property
    def title(self) -> str:
        return self.meta.get("title", self.id)

    @property
    def stack(self) -> str:
        return self.meta.get("stack", "none")

    @property
    def minutes(self) -> int:
        return int(self.meta.get("minutes", 0))

    @property
    def tier(self) -> str:
        return self.meta.get("tier", "core")

    @property
    def stack_source(self) -> str:
        """Which track's stack this exercise runs against.

        Almost always its own. Mixed incidents borrow an existing stack rather
        than duplicating one, because the point of that track is a familiar
        system with an unfamiliar, unlabelled failure.
        """
        return self.meta.get("stack_source") or self.track

    def stack_dir(self) -> Path:
        return LABS / self.stack_source / "_stack"

    def questions(self) -> list[dict]:
        """The multiple choice set that replaced the spoken answer.

        JSON rather than YAML on purpose. A question set is a list of mappings
        each holding a list of mappings, and parse_meta_subset refuses nested
        mappings by design. Teaching it to nest for authoring comfort alone
        would put every meta.yaml at risk for no gain.
        """
        path = self.path / "questions.json"
        if not path.is_file():
            return []
        return json.loads(path.read_text())


def load_exercises() -> list[Exercise]:
    found: list[Exercise] = []
    for meta_path in sorted(LABS.glob("*/*/meta.yaml")):
        if meta_path.parent.name.startswith("_"):
            continue
        meta = parse_meta(meta_path.read_text(), str(meta_path.relative_to(ROOT)))
        exercise_id = f"{meta_path.parent.parent.name}/{meta_path.parent.name}"
        found.append(Exercise(id=exercise_id, path=meta_path.parent, meta=meta))

    def sort_key(exercise: Exercise) -> tuple[int, str]:
        track = exercise.track
        rank = TRACK_ORDER.index(track) if track in TRACK_ORDER else len(TRACK_ORDER)
        return rank, exercise.id

    return sorted(found, key=sort_key)


def resolve(reference: str) -> Exercise:
    """Accept a full id, a track/number prefix, or a unique substring."""
    exercises = load_exercises()
    reference = reference.strip().rstrip("/")

    exact = [e for e in exercises if e.id == reference]
    if exact:
        return exact[0]

    prefix = [e for e in exercises if e.id.startswith(reference)]
    if len(prefix) == 1:
        return prefix[0]

    partial = [e for e in exercises if reference in e.id]
    if len(partial) == 1:
        return partial[0]

    if not prefix and not partial:
        sys.exit(f"tse: no exercise matches {reference!r}. Run `tse list`.")

    options = "\n  ".join(e.id for e in (prefix or partial))
    sys.exit(f"tse: {reference!r} is ambiguous. Did you mean one of:\n  {options}")


# --------------------------------------------------------------------------- #
# State
# --------------------------------------------------------------------------- #

def read_state() -> dict:
    path = ROOT / STATE_FILENAME
    if not path.is_file():
        return {"current": None, "hints": {}, "completed": []}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return {"current": None, "hints": {}, "completed": []}


def write_state(state: dict) -> None:
    (ROOT / STATE_FILENAME).write_text(json.dumps(state, indent=2) + "\n")


def current_exercise() -> Exercise:
    state = read_state()
    if not state.get("current"):
        sys.exit("tse: no active exercise. Start one with `tse start <id>`.")
    return resolve(state["current"])


