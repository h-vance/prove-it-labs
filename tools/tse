# Stack adapters
# --------------------------------------------------------------------------- #

KIND_CLUSTER = "proveit"
KIND_CONTEXT = f"kind-{KIND_CLUSTER}"
LAB_NAMESPACE = "tse-training"
# Pre-loaded into the node so exercises start without a registry round trip,
# and so a deliberate ImagePullBackOff is the only pull failure a learner sees.
KIND_IMAGES = ["python:3.12-alpine"]


def kubectl(*args: str) -> list[str]:
    return ["kubectl", "--context", KIND_CONTEXT, *args]


def cluster_exists() -> bool:
    result = subprocess.run(["kind", "get", "clusters"], capture_output=True, text=True, encoding="utf-8")
    return KIND_CLUSTER in result.stdout.split()


def node_platform() -> str | None:
    """The platform kind nodes run as, asked rather than inferred.

    A kind node is a container on the local Docker daemon, so the daemon's
    own architecture is the answer, and it already reports Go naming
    ("amd64", "arm64") which is exactly what --platform wants. Deriving this
    from `uname -m` instead means maintaining a mapping table and shipping a
    branch that only ever runs on hardware the author does not have.

    Returns None when it cannot be determined, in which case preloading is
    skipped rather than guessed at.
    """
    result = subprocess.run(
        ["docker", "version", "--format", "{{.Server.Arch}}"], capture_output=True, text=True, encoding="utf-8"
    )
    arch = result.stdout.strip()
    if result.returncode != 0 or not arch or "/" in arch or " " in arch:
        return None
    return f"linux/{arch}"


def image_in_node(image: str) -> bool:
    """Whether the node actually has the image, rather than whether load exited 0."""
    result = subprocess.run(
        ["docker", "exec", f"{KIND_CLUSTER}-control-plane", "crictl", "images"],
        capture_output=True,
        text=True, encoding="utf-8",
    )
    repository, _, tag = image.rpartition(":")
    return any(
        repository in line and tag in line for line in result.stdout.splitlines()
    )


def preload_images() -> None:
    """Put the lab images into the node so exercises start without a pull.

    Best effort throughout. If any step fails the cluster simply pulls from the
    registry on first use, which is slower and equally correct, so nothing here
    is allowed to fail a cluster creation.
    """
    platform = node_platform()
    if platform is None:
        print(f"{DIM}Could not determine the node platform; images will be pulled on use.{OFF}")
        return

    for image in KIND_IMAGES:
        # Preloading has to go through a single-platform archive. `kind load
        # docker-image` imports with --all-platforms, which Docker's containerd
        # image store answers with a multi-arch manifest whose per-platform
        # content is not present locally, and it fails on a missing digest.
        archive = Path(tempfile.gettempdir()) / f"tse-{image.replace(':', '-').replace('/', '-')}.tar"
        steps = [
            ["docker", "pull", "-q", "--platform", platform, image],
            ["docker", "save", "--platform", platform, image, "-o", str(archive)],
            ["kind", "load", "image-archive", str(archive), "--name", KIND_CLUSTER],
        ]
        for step in steps:
            if subprocess.run(step, capture_output=True).returncode != 0:
                break
        archive.unlink(missing_ok=True)

        if image_in_node(image):
            print(f"{DIM}Preloaded {image} ({platform}).{OFF}")
        else:
            print(f"{DIM}Could not preload {image}; the cluster will pull it on first use.{OFF}")


def ensure_cluster() -> None:
    """Create the shared cluster once, then reuse it for every exercise.

    Creating a cluster per exercise would add roughly a minute to every start
    for no teaching value. The namespace is the unit that gets torn down.
    """
    if cluster_exists():
        return

    config = LABS / "kubernetes" / "_stack" / "kind-cluster.yaml"
    print(f"{DIM}Creating the {KIND_CLUSTER} cluster. This happens once and takes a minute.{OFF}")
    run(["kind", "create", "cluster", "--name", KIND_CLUSTER, "--config", str(config)])

    preload_images()


def reset_namespace() -> None:
    subprocess.run(
        kubectl("delete", "namespace", LAB_NAMESPACE, "--ignore-not-found", "--wait=true"),
        check=False,
        capture_output=True,
    )


def compose_command(exercise: Exercise) -> list[str]:
    stack = exercise.stack_dir()
    command = ["docker", "compose", "-f", str(stack / "compose.yaml")]
    override = stack / "compose.override.yaml"
    if override.is_file():
        command += ["-f", str(override)]
    return command


def managed_files(track: str) -> set[str]:
    """Every filename any exercise in this track writes into the shared stack.

    Tracked so that switching exercises cannot leave a previous exercise's
    file behind and silently change what the next one is investigating.
    """
    names: set[str] = set()
    for exercise in load_exercises():
        # Keyed on the stack source rather than the exercise's own track, or a
        # mixed incident borrowing the Docker stack would leave its files
        # behind and silently change what the next Docker exercise starts from.
        #
        # Kubernetes is excluded: its manifests are applied to a cluster and
        # stay in the exercise, so they are committed source, not generated
        # state.
        if exercise.stack_source != track or exercise.stack not in {"compose", "none"}:
            continue
        for variant in ("setup", "solution"):
            directory = exercise.path / variant
            if directory.is_dir():
                names.update(item.name for item in directory.iterdir() if item.is_file())
    return names


def provision(exercise: Exercise, *, variant: str) -> None:
    """Put the environment into the exercise's broken or fixed state.

    variant is "setup" for the state the learner investigates, or "solution"
    for the corrected state, which only `tse verify` uses.
    """
    source_dir = exercise.path / variant
    if not source_dir.is_dir():
        sys.exit(f"tse: {exercise.id} has no {variant}/ directory")

    # Before anything is copied, applied or started. Everything below this line
    # hands a contributed file to Docker or to kubectl, and a check that runs
    # afterwards is a report rather than a guard.
    check_contributed_files(source_dir, stack=exercise.stack)

    if exercise.stack == "kind":
        ensure_cluster()
        reset_namespace()
        run(kubectl("apply", "-f", str(exercise.stack_dir() / "base.yaml")))
        for manifest in sorted(source_dir.glob("*.yaml")):
            run(kubectl("apply", "-n", LAB_NAMESPACE, "-f", str(manifest)))
        return

    if exercise.stack not in {"compose", "none"}:
        sys.exit(
            f"tse: the {exercise.stack!r} stack is not implemented yet.\n"
            f"     {exercise.id} cannot be started in this phase of the course."
        )

    materialize(exercise, source_dir)

    # A "none" exercise has files but no system. Communication exercises are
    # graded on what the learner writes, so there is nothing to bring up.
    if exercise.stack == "compose":
        run(compose_command(exercise) + ["up", "-d", "--build", "--force-recreate"])
        stack_self_check(exercise)


def stack_self_check(exercise: Exercise) -> None:
    """
    Let a stack assert its own integrity before a learner is handed it.

    If `_stack/self-check.sh` exists it is run after the stack comes up, and a
    non-zero exit stops the exercise there rather than letting somebody debug a
    symptom that has nothing to do with the lesson.

    The networking stack is why this exists. It builds its own certificate
    authority, and the generator mints fresh keys every time it runs, so a build
    that runs it twice hands the gateway and the client two different CAs whose
    subject lines are byte for byte identical and whose fingerprints are not.
    Everything then fails on an unknown issuer, which is not what any exercise
    in that track teaches, and the natural suspect is the content.

    `tse` builds every service in one invocation, which shares the generator and
    is why this has never been seen in the learner path. This is here for the
    ways round that: a hand-run `docker compose build <service>`, or a build
    cache evicted between two of them.
    """
    script = exercise.stack_dir() / "self-check.sh"
    if not script.is_file():
        return
    result = subprocess.run(
        ["bash", str(script)], cwd=ROOT, capture_output=True,
        text=True, encoding="utf-8", errors="replace", timeout=RECORD_TIMEOUT_S,
    )
    if result.returncode != 0:
        sys.exit(
            f"{RED}tse: the {exercise.stack_source} stack came up in a state no "
            f"exercise can be run against.{OFF}\n\n"
            + (result.stdout + result.stderr).rstrip()
        )


def materialize(exercise: Exercise, source_dir: Path) -> None:
    """Copy a variant's files into the shared stack, clearing prior ones first.

    Checks the files again even though `provision` already did. This is the
    function that actually writes them, so it is the one that has to be safe on
    its own: a later caller that forgets the check would otherwise reopen the
    hole silently, which is how the hole got there the first time.
    """
    check_contributed_files(source_dir, stack=exercise.stack)
    stack = exercise.stack_dir()
    stack.mkdir(parents=True, exist_ok=True)
    for name in managed_files(exercise.stack_source):
        (stack / name).unlink(missing_ok=True)
    for item in sorted(source_dir.iterdir()):
        if item.is_file():
            destination = stack / item.name
            shutil.copyfile(item, destination)
            if item.suffix == ".sh":
                destination.chmod(0o755)


def teardown(exercise: Exercise) -> None:
    if exercise.stack == "kind":
        # The namespace goes, the cluster stays. Rebuilding the cluster between
        # exercises would cost a minute each time and prove nothing.
        if cluster_exists():
            reset_namespace()
        return
    if exercise.stack not in {"compose", "none"}:
        return
    if exercise.stack == "compose":
        run(compose_command(exercise) + ["down", "--remove-orphans"], check=False)
    stack = exercise.stack_dir()
    for name in managed_files(exercise.stack_source):
        (stack / name).unlink(missing_ok=True)


def run(command: list[str], *, check: bool = True) -> int:
    sys.stdout.flush()
    result = subprocess.run(command)
    if check and result.returncode != 0:
        sys.exit(f"tse: command failed: {' '.join(command)}")
    return result.returncode


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #

# Paths that change the meaning of every exercise at once, so a change to any
# of them has to re-verify the whole course rather than a corner of it.
#
# `tools/` is here because of a real failure. Bounding an assertion moved every
# grader's command into a fresh shell, which broke the two exercises that used
# a variable or a function the new shell had never seen. Nothing under `labs/`
# was touched by that commit. A rule that only looked at exercise directories
# would have verified nothing and reported green.
WIDE_PATHS = ("tools/", ".github/workflows/verify.yml")


def affected_exercises(changed: list[str]) -> list[str]:
    """
    Which exercises a set of changed files can actually break.

    Verifying all twenty five costs about eighty billable minutes, which is
    roughly twenty two pushes a month on a private repository's allowance, and
    it was reached. Most commits cannot affect most exercises, and this says
    which ones can.

    Deliberately generous in both directions it can be wrong. A shared stack
    means the whole track, because the exercises in a track share one set of
    containers. Anything under `tools/` means everything, because that is where
    the grader and the recorder live. What is left is a change inside one
    exercise, which is the common case and is one job.

    The cost of being too generous is a slow run. The cost of being too narrow
    is a green tick on an exercise nobody checked, so where these two are in
    tension this errs at the wide end.
    """
    ids = [exercise.id for exercise in load_exercises()]
    if any(path.startswith(WIDE_PATHS) for path in changed):
        return ids

    selected: set[str] = set()
    for path in changed:
        parts = Path(path).parts
        if len(parts) < 3 or parts[0] != "labs":
            continue
        track, second = parts[1], parts[2]
        if second.startswith("_"):
            # A shared stack, so every exercise in the track is in scope.
            selected.update(i for i in ids if i.startswith(f"{track}/"))
        else:
            selected.update(i for i in ids if i == f"{track}/{second}")
    return [i for i in ids if i in selected]


def group_by_stack(ids: list[str]) -> list[dict]:
    """
    The same exercises, gathered under the stack each one runs against.

    One job per exercise was costing about three quarters of its minutes on
    things that are not testing. Measured over a real run: 25 jobs, 37 minutes
    of work inside the test steps, 31 minutes of runner startup and teardown
    around them, and 16 more lost to per-job billing rounding.

    On top of that the same stack was built once per exercise rather than once.
    Kubernetes backs five exercises and was built five times from nothing.

    Grouped, a job builds its stack once and every exercise after the first
    reuses the layers. `tse verify` still recreates the containers for each one,
    so what is shared is the image cache and not the state.

    Ordered by size, largest first, because the matrix starts jobs in order and
    the longest one should not be the last to begin.
    """
    grouped: dict[str, list[str]] = {}
    for exercise in load_exercises():
        if exercise.id in ids:
            grouped.setdefault(exercise.stack_source, []).append(exercise.id)
    return [
        {"stack": stack, "exercises": grouped[stack]}
        for stack in sorted(grouped, key=lambda name: (-len(grouped[name]), name))
    ]


def cmd_affected(args: argparse.Namespace) -> None:
    """
    Read changed paths on stdin, print what CI has to run.

    `--for-github` writes the matrix straight into $GITHUB_OUTPUT and prints a
    readable summary. That exists because the alternative is a here-doc of
    Python inside a YAML `run:` block inside a shell string, which is three
    levels of quoting and got the escaping wrong twice before this function
    existed. Every line of it also had to be tested by pushing, which is the
    resource this whole change is trying not to spend.
    """
    changed = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]
    ids = affected_exercises(changed)
    groups = group_by_stack(ids)
    payload = json.dumps(groups if args.by_stack else ids)

    if not args.for_github:
        print(payload)
        return

    destination = os.environ.get("GITHUB_OUTPUT")
    if not destination:
        sys.exit("tse: --for-github needs GITHUB_OUTPUT set, so this is not a runner.")
    with open(destination, "a", encoding="utf-8") as out:
        out.write(f"groups={json.dumps(groups)}\n")
        out.write(f"count={len(ids)}\n")

    print(f"Verifying {len(ids)} exercise(s) in {len(groups)} job(s).")
    for group in groups:
        print(f"  {group['stack']:<14} {len(group['exercises'])}")


def cmd_list(args: argparse.Namespace) -> None:
    state = read_state()
    completed = set(state.get("completed", []))
    current = state.get("current")
    exercises = load_exercises()

    if args.track:
        exercises = [e for e in exercises if e.track == args.track]

    if args.ids:
        print(json.dumps([e.id for e in exercises]))
        return

    if not exercises:
        print("No exercises found.")
        return

    track = None
    for exercise in exercises:
        if exercise.track != track:
            track = exercise.track
            print(f"\n{BOLD}{track}{OFF}")
        if exercise.id in completed:
            mark = f"{GREEN}done{OFF}"
        elif exercise.id == current:
            mark = f"{YELLOW}open{OFF}"
        else:
            mark = "    "
        tier = "" if exercise.tier == "core" else f" {DIM}[stretch]{OFF}"
        print(f"  {mark}  {exercise.id:<48} {exercise.minutes:>3}m  {exercise.title}{tier}")

    print(f"\n{len(completed)} of {len(load_exercises())} exercises completed.")


def cmd_start(args: argparse.Namespace) -> None:
    exercise = resolve(args.exercise)
    print(f"Provisioning {exercise.id} ...\n")
    provision(exercise, variant="setup")

    state = read_state()
    state["current"] = exercise.id
    state.setdefault("hints", {})[exercise.id] = 0
    write_state(state)

    print()
    print_ticket(exercise)


def print_ticket(exercise: Exercise) -> None:
    ticket = exercise.path / "ticket.md"
    if ticket.is_file():
        print(ticket.read_text().rstrip())
    print(f"\n{DIM}Gather evidence, then run `tse check`. Stuck? `tse hint`.{OFF}")


def cmd_ticket(args: argparse.Namespace) -> None:
    print_ticket(current_exercise())


def cmd_check(args: argparse.Namespace) -> None:
    exercise = resolve(args.exercise) if args.exercise else current_exercise()
    script = exercise.path / "check.sh"
    if not script.is_file():
        sys.exit(f"tse: {exercise.id} has no check.sh")

    env = os.environ.copy()
    env.update(
        TSE_ROOT=str(ROOT),
        TSE_LIB=str(LIB),
        TSE_EXERCISE_DIR=str(exercise.path),
        TSE_STACK_DIR=str(exercise.stack_dir()),
    )
    print(f"{BOLD}{exercise.id}{OFF}  {exercise.title}\n")
    result = subprocess.run(["bash", str(script)], env=env)

    if result.returncode == 0:
        state = read_state()
        completed = set(state.get("completed", []))
        if exercise.id not in completed:
            completed.add(exercise.id)
            state["completed"] = sorted(completed)
            write_state(state)
        print(f"\n{GREEN}Resolved.{OFF} Write the customer update before you move on.")
        print(f"{DIM}Compare your reasoning with `tse answer`, "
              f"then check it holds up with `tse quiz`.{OFF}")
    sys.exit(result.returncode)


def cmd_hint(args: argparse.Namespace) -> None:
    exercise = current_exercise()
    hints = sorted((exercise.path / "hints").glob("*.md")) if (exercise.path / "hints").is_dir() else []
    if not hints:
        sys.exit(f"tse: {exercise.id} has no hints. Try `tse answer`.")

    state = read_state()
    shown = int(state.get("hints", {}).get(exercise.id, 0))
    if shown >= len(hints):
        print(f"{DIM}All {len(hints)} hints shown. `tse answer` reveals the root cause.{OFF}")
        return

    print(f"{BOLD}Hint {shown + 1} of {len(hints)}{OFF}\n")
    print(hints[shown].read_text().rstrip())
    state.setdefault("hints", {})[exercise.id] = shown + 1
    write_state(state)

    remaining = len(hints) - (shown + 1)
    if remaining:
        print(f"\n{DIM}{remaining} hint(s) left. Run `tse hint` again if you need one.{OFF}")


def cmd_answer(args: argparse.Namespace) -> None:
    exercise = current_exercise()
    solution = exercise.path / "solution.md"
    if not solution.is_file():
        sys.exit(f"tse: {exercise.id} has no solution.md")
    print(solution.read_text().rstrip())


def ask_choice(count: int) -> int | None:
    """Read a 1-based answer from stdin, return it 0-based, or None at end of input.

    Returning None on EOF is what lets the smoke test drive the quiz from a
    pipe: it answers what it means to answer and then stops cleanly instead of
    spinning on an empty read.
    """
    while True:
        try:
            raw = input(f"\nYour answer [1-{count}]: ").strip()
        except EOFError:
            return None
        if raw.isdigit() and 1 <= int(raw) <= count:
            return int(raw) - 1
        print(f"{YELLOW}Enter a number from 1 to {count}.{OFF}")


def cmd_quiz(args: argparse.Namespace) -> None:
    """Check understanding once the system is fixed.

    Deliberately its own command rather than part of check.sh. `tse verify`
    runs every check non-interactively against both states in CI, so a check
    that waited for keyboard input would hang the matrix rather than fail it.
    """
    exercise = resolve(args.exercise) if args.exercise else current_exercise()
    questions = exercise.questions()
    if not questions:
        sys.exit(f"tse: {exercise.id} has no questions.json")

    print(f"{BOLD}{exercise.id}{OFF}  {exercise.title}")
    print(f"{DIM}{len(questions)} questions. Answer with the number.{OFF}")

    score = 0
    for number, question in enumerate(questions, start=1):
        options = question["options"]
        print(f"\n{BOLD}Question {number} of {len(questions)}{OFF}")
        print(f"{question['question']}\n")
        for index, option in enumerate(options, start=1):
            print(f"  {index}. {option['text']}")

        choice = ask_choice(len(options))
        if choice is None:
            print(f"\n{DIM}Stopping here. Nothing recorded.{OFF}")
            return

        chosen = options[choice]
        # A symbol as well as a color, because NO_COLOR is set on plenty of
        # terminals and "correct" must never be carried by color alone.
        if chosen.get("correct"):
            score += 1
            print(f"\n{GREEN}✓ Correct.{OFF} {chosen['explanation']}")
        else:
            answer = next(o for o in options if o.get("correct"))
            print(f"\n{RED}✗ Not quite.{OFF} {chosen['explanation']}")
            print(f"\n{BOLD}The answer: {answer['text']}{OFF}")
            print(answer["explanation"])

    total = len(questions)
    print(f"\n{BOLD}{score}/{total}{OFF}")
    if score == total:
        print(f"{GREEN}All of them.{OFF} You can explain this one, not just fix it.")
    else:
        print(f"{DIM}Re-read `tse answer` on the ones you missed, then run this again.{OFF}")

    state = read_state()
    record = state.setdefault("quiz", {})
    if score > record.get(exercise.id, {}).get("correct", -1):
        record[exercise.id] = {"correct": score, "total": total}
        write_state(state)


def private_leaks(output: str, foreign: set[str]) -> list[str]:
    """Anything in this output that belongs to the machine rather than the lab.

    Transcripts are committed and published, so the standard is that nothing
    identifying the person who recorded them can survive. This is the second
    line of defense: the first is that stored output is scrubbed, and this
    catches the categories a scrub rule would not think to look for.
    """
    found = [name for name in sorted(foreign) if name in output]

    # /home/runner is GitHub Actions' own checkout, exempted for the same
    # reason REPO_LEAK_PATTERNS exempts it: it turns up in legitimately
    # recorded CI output and belongs to nobody. That exemption existed on one
    # of the two lists and not the other, which left `tse record` able to
    # refuse a perfectly clean recording made on a runner.
    home = str(Path.home())
    if home not in {"/home/runner"} and home in output:
        found.append(home)

    # getpass reads the environment first and falls back to the password
    # database. Reading $USER alone meant that in any shell that does not set
    # it, a cron job or a stripped container, the username check did nothing
    # at all and said nothing about it.
    try:
        user = getpass.getuser()
    except (KeyError, OSError):
        user = ""
    if user and user != "runner" and re.search(rf"\b{re.escape(user)}\b", output):
        found.append(user)

    hostname = socket.gethostname()
    if hostname and hostname not in {"localhost"} and hostname in output:
        found.append(hostname)

    # Cloud account identifiers. A kubeconfig commonly holds a production
    # cluster next to the lab one, and an ARN carries an account number.
    for pattern in (r"arn:aws:\S+", r"\b\d{12}\.dkr\.ecr\b", r"\b[A-Z0-9]{20}\b"):
        found += re.findall(pattern, output)

    # Home directories from any platform, not just this one.
    found += re.findall(r"/(?:Users|home)/[A-Za-z0-9._-]+", output)

    return sorted(set(found))


def history_leaks() -> list[str]:
    """Leaks in lines this repository has ever added, not just the ones it kept.

    Deleting a secret in a later commit does not remove it from a clone, so the
    published history has to be clean too, not only the published tree. Only
    added lines are examined: a removed line was already present as an added one
    in the commit that introduced it, so scanning both would double every
    finding and make the report harder to act on.

    Author and committer fields are scanned too. They are not part of any diff,
    so a scan of patches alone reads none of them, and the commonest way a real
    address reaches a public repository is not a file at all: it is `git config
    user.email` on a laptop. An outside audit pointed this out while every
    other check here was passing.
    """
    # A shallow clone holds one commit, so this would sweep almost nothing and
    # report it as clean. actions/checkout is shallow by default, which makes
    # that the likeliest way to run it, and a vacuous pass here is worse than no
    # scan at all: it is the one result somebody would trust before going public.
    shallow = subprocess.run(
        ["git", "rev-parse", "--is-shallow-repository"],
        capture_output=True, text=True, encoding="utf-8", cwd=ROOT,
    )
    # The guard has to survive its own command failing. Comparing only the text
    # meant a git that errored produced an empty string, which is not "true",
    # which read as a full clone and let the scan proceed. That is the exact
    # vacuous pass the paragraph above calls worse than no scan at all, sitting
    # inside the check written to prevent it.
    if shallow.returncode != 0:
        sys.exit(
            "tse: could not tell whether this is a shallow clone, so scanning "
            "its history\n     would prove nothing. "
            f"{shallow.stderr.strip().splitlines()[0] if shallow.stderr.strip() else ''}"
        )
    if shallow.stdout.strip() == "true":
        sys.exit(
            "tse: this is a shallow clone, so scanning its history would prove nothing.\n"
            "     Run `git fetch --unshallow` first, or drop --history."
        )

    findings: list[str] = []

    # Identities first, across every ref rather than just the current branch.
    # A branch that is pushed is published whether or not it is merged.
    identities = subprocess.run(
        ["git", "log", "--all", "--no-color",
         "--format=%h%x00%an%x00%ae%x00%cn%x00%ce"],
        capture_output=True, text=True, encoding="utf-8", cwd=ROOT,
    )
    if identities.returncode != 0:
        sys.exit("tse: `git log` failed, so the history could not be scanned.")
    for line in identities.stdout.splitlines():
        if not line:
            continue
        commit, *fields = line.split("\x00")
        for label, value in zip(("author", "author email",
                                 "committer", "committer email"), fields):
            for _, description, matched in scan_for_leaks(value, REPO_LEAK_PATTERNS):
                findings.append(f"{commit} ({label}): {description}: {matched!r}")

    result = subprocess.run(
        ["git", "log", "--all", "-p", "--no-color", "--no-merges",
         "--format=commit %h"],
        capture_output=True, text=True, encoding="utf-8", cwd=ROOT,
    )
    if result.returncode != 0:
        sys.exit("tse: `git log -p` failed, so the history could not be scanned.")

    commit = ""
    path = ""
    for line in result.stdout.splitlines():
        if line.startswith("commit "):
            commit = line.split(maxsplit=1)[1]
        elif line.startswith("diff --git a/"):
            path = line.split(" b/", 1)[-1]
        elif line.startswith("+") and not line.startswith("+++"):
            if path in LEAK_EXEMPT:
                continue
            for _, description, matched in scan_for_leaks(line[1:], leak_patterns_for(path)):
                findings.append(f"{commit} {path}: {description}: {matched!r}")
    return findings


# --------------------------------------------------------------------------- #
# Links
# --------------------------------------------------------------------------- #

# Where a link can be written in this repository. Collected together rather
# than one regex, because a markdown link, an HTML attribute and a bare URL in
# a comment are three different shapes and the last of those is where the two
# stale references in this repository were actually hiding.
LINK_PATTERNS: list["re.Pattern[str]"] = [
    # [text](target) and [text](target "title"), with optional angle brackets.
    re.compile(r"\[[^\]]*\]\(\s*<?([^)\s>]+)>?(?:\s+\"[^\"]*\")?\s*\)"),
    re.compile(r"href=\"([^\"]+)\""),
    # A bare URL in prose, a comment, or a YAML value. Trailing punctuation is
    # excluded so a sentence ending in a link does not report the full stop as
    # part of the address.
    re.compile(r"(https?://[^\s\"'<>)\]}`,]+)"),
]

# Addresses a learner types into their own terminal. They are instructions, not
# links, and nothing on the internet answers them. Counted in the summary so
# that skipping them is visible rather than an unexplained gap.
#
# A host with no dot in it belongs here too, and finding that out is what this
# check is for. `https://gateway:8443` and `http://orders-api:8080` are service
# names on a Compose or Kubernetes network, and they look exactly like public
# addresses. A public host always has a dot; a bare label never resolves off
# the lab network.
LAB_HOSTS = ("127.0.0.1", "localhost", "0.0.0.0", "[::1]")

# A URL with a variable in it is a template, not an address. `.devcontainer`
# builds a download URL from `${KIND_VERSION}`, and requesting the literal text
# gets a 404 that says nothing about whether the real URL works.
INTERPOLATION = ("${", "$(", "{{", "`", "%s", "{version")

# Files worth reading for links at all. A transcript is recorded output, and a
# URL inside it is something a lab printed rather than something anybody wrote.
LINK_SUFFIXES = (".md", ".mdx", ".astro", ".ts", ".tsx", ".yml", ".yaml", ".txt", ".sh")


def site_base_path() -> str:
    """
    The site's base path, read from the Astro config rather than repeated here.

    A site-absolute link has to start with this, and the repository already got
    that wrong: `how-it-works.mdx` still pointed at
    `/technical-support-engineering/...` after the rename, so the link to the
    spoken answer template was a 404 on the published site. Hard-coding the
    base in this file would have made this check agree with the bug.
    """
    config = ROOT / "site" / "astro.config.ts"
    if not config.is_file():
        return ""
    found = re.search(r"""base:\s*["']([^"']+)["']""", config.read_text(encoding="utf-8"))
    return found.group(1) if found else ""


def extract_links(text: str) -> list[tuple[int, str]]:
    """Every link in this text, as (line number, target), deduplicated."""
    found: list[tuple[int, str]] = []
    seen: set[tuple[int, str]] = set()
    for number, line in enumerate(text.splitlines(), start=1):
        for pattern in LINK_PATTERNS:
            for match in pattern.finditer(line):
                target = match.group(1).strip()
                if not target or (number, target) in seen:
                    continue
                seen.add((number, target))
                found.append((number, target))
    return found


def classify_link(target: str, own: tuple[str, ...] = ()) -> str:
    """
    What kind of link this is, which decides what checking it even means.

    `lab` is the interesting one. Those addresses look exactly like external
    links and must never be requested: they are what the exercise tells a
    learner to curl, and on the machine running this check they are either
    nothing or, worse, somebody else's service.

    `self` is the awkward one. This repository links to itself in the README
    badge, in SECURITY.md and from the site, and every one of those returns 404
    while the repository is private, because that is what GitHub shows a
    stranger. Reporting them as broken would be wrong, and skipping every
    github.com/<owner>/ link would have hidden the genuinely stale one this
    check was written to find. So `own` is the repository's real address, read
    from the git remote, and only an exact match on it is skipped. A link to
    the name this repository used to have is a different string and still fails.
    """
    lowered = target.lower()
    if lowered.startswith(("mailto:", "tel:", "data:", "javascript:")):
        return "ignored"
    if any(marker in target for marker in INTERPOLATION):
        return "ignored"
    if lowered.startswith(("http://", "https://")):
        host = lowered.split("://", 1)[1].split("/", 1)[0].split(":")[0]
        if host in LAB_HOSTS or "." not in host:
            return "lab"
        if own and lowered.startswith(own):
            return "self"
        return "external"
    if target.startswith("#"):
        return "anchor"
    if target.startswith("/"):
        return "site-absolute"
    return "relative"


def own_urls() -> tuple[str, ...]:
    """
    The addresses this repository uses to refer to itself.

    Derived rather than written down, so renaming the repository cannot leave a
    stale exemption behind that quietly stops checking the very links the
    rename broke. That is not hypothetical: the rename to prove-it-labs left
    two dead self-references, and both are what this check found first.

    THE DAY THIS REPOSITORY GOES PUBLIC: these stop returning 404 and this
    function stops being needed. Deleting it then is the check getting stronger.
    """
    found: list[str] = []
    result = subprocess.run(
        ["git", "remote", "get-url", "origin"],
        capture_output=True, text=True, encoding="utf-8", cwd=ROOT,
    )
    if result.returncode == 0 and result.stdout.strip():
        remote = result.stdout.strip().removesuffix(".git")
        if remote.startswith("http"):
            found.append(remote.lower())
        elif remote.startswith("git@github.com:"):
            found.append("https://github.com/" + remote.split(":", 1)[1].lower())

    config = ROOT / "site" / "astro.config.ts"
    if config.is_file():
        site = re.search(r"""site:\s*["']([^"']+)["']""", config.read_text(encoding="utf-8"))
        if site:
            found.append(site.group(1).rstrip("/").lower())
    return tuple(found)


def heading_slugs(text: str) -> set[str]:
    """The anchors a markdown file offers, slugified the way the site does."""
    slugs = set()
    for line in text.splitlines():
        if line.startswith("#"):
            title = line.lstrip("#").strip()
            slug = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
            if slug:
                slugs.add(slug)
    return slugs


def check_local_link(target: str, source: str, base: str) -> str | None:
    """
    Why this link is broken, or None if it resolves.

    Local only. Nothing here touches the network, which is what lets the whole
    of it be tested without one.
    """
    kind = classify_link(target)
    path, _, fragment = target.partition("#")

    if kind == "anchor":
        text = read_link_source(ROOT / source)
        if text is None:
            return None
        if fragment not in heading_slugs(text):
            return f"no heading on this page makes the anchor #{fragment}"
        return None

    if kind == "site-absolute":
        if base and not target.startswith(base + "/") and target != base:
            return f"a site link that does not start with the site's base path {base!r}"
        return None

    if kind != "relative":
        return None

    resolved = (ROOT / source).parent / path
    if resolved.exists():
        if fragment and resolved.is_file() and resolved.suffix in (".md", ".mdx"):
            text = read_link_source(resolved)
            if text is not None and fragment not in heading_slugs(text):
                return f"{path} exists but has no heading making the anchor #{fragment}"
        return None
    return f"no such file: {path}"


def read_link_source(path: Path) -> str | None:
    """The text of a file, or None if it is not readable as text."""
    try:
        return decode_for_scanning(path.read_bytes())
    except OSError:
        return None


def cmd_links(args: argparse.Namespace) -> None:
    """
    Refuse to publish a link that goes nowhere.

    Twenty five exercise pages, a README, a contributing guide and a set of
    reference sheets, and nothing had ever confirmed that a single link in any
    of them resolved. Two were already broken when this was written, both left
    over from renaming the repository: a GitHub link in the site's front page
    and, worse, a site-internal link in `how-it-works.mdx` that still carried
    the old base path and returned 404 to anybody who clicked it.

    A 404 or a 410 fails. Everything else is a warning, deliberately. A timeout
    or a 503 is the network having a bad minute, and a gate that goes red for
    that is a gate people learn to ignore, which costs more than it catches.
    """
    import urllib.error
    import urllib.request

    base = site_base_path()
    own = own_urls()
    problems: list[str] = []
    warnings: list[str] = []
    external: dict[str, list[str]] = {}
    counted = {"checked": 0, "lab": 0, "files": 0, "self": 0}

    for name in tracked_files():
        if not name.endswith(LINK_SUFFIXES) or name in LEAK_EXEMPT:
            continue
        text = read_link_source(ROOT / name)
        if text is None:
            continue
        counted["files"] += 1
        for number, target in extract_links(text):
            kind = classify_link(target, own)
            if kind == "ignored":
                continue
            if kind == "lab":
                counted["lab"] += 1
                continue
            if kind == "self":
                counted["self"] += 1
                continue
            counted["checked"] += 1
            if kind == "external":
                external.setdefault(target, []).append(f"{name}:{number}")
                continue
            problem = check_local_link(target, name, base)
            if problem:
                problems.append(f"{name}:{number}: {target}\n      {problem}")

    if args.offline:
        print(f"{DIM}Skipping {len(external)} external links (--offline).{OFF}")
    else:
        for url, where in sorted(external.items()):
            status, detail = probe_url(url)
            if status in (404, 410):
                problems.append(f"{where[0]}: {url}\n      the server said {status}")
            elif detail:
                warnings.append(f"{where[0]}: {url}\n      {detail}")

    if warnings:
        print(f"{YELLOW}{len(warnings)} links could not be reached:{OFF}\n")
        for warning in warnings:
            print(f"  {warning}")
        print(f"\n{DIM}Not failures. A link is only called broken here when the "
              f"server answers 404 or 410.{OFF}\n")

    if problems:
        print(f"{RED}tse: {len(problems)} links go nowhere:{OFF}\n")
        for problem in problems:
            print(f"  {problem}")
        sys.exit(1)

    scope = (f"{counted['checked']} links across {counted['files']} files, "
             f"{counted['lab']} lab addresses skipped")
    if counted["self"]:
        # Named rather than absorbed into the skip count, because these are the
        # links that will start being checkable the day this goes public, and a
        # number nobody can see is a number nobody revisits.
        scope += (f", {counted['self']} pointing at this repository "
                  f"(404 to a stranger while it is private)")
    if not args.offline:
        scope += f", {len(external)} of them external"
    print(f"{GREEN}Every link resolves.{OFF} {scope}.")


def probe_url(url: str) -> tuple[int | None, str]:
    """
    Ask what is at a URL, as cheaply as the server allows.

    HEAD first, then GET, because a surprising number of servers answer HEAD
    with 403 or 405 while serving the page perfectly well. A browser-shaped
    user agent for the same reason: the default `Python-urllib` gets a 403 from
    several large sites, and reporting somebody's own README link as broken
    because of that would make this check worse than nothing.
    """
    import urllib.error
    import urllib.request

    for method in ("HEAD", "GET"):
        request = urllib.request.Request(url, method=method, headers={
            "User-Agent": "Mozilla/5.0 (compatible; prove-it-labs link check)",
        })
        try:
            with urllib.request.urlopen(request, timeout=LINK_TIMEOUT_S) as response:
                return response.status, ""
        except urllib.error.HTTPError as error:
            if error.code in (403, 405) and method == "HEAD":
                continue
            return error.code, "" if error.code in (404, 410) else f"the server said {error.code}"
        except Exception as error:  # noqa: BLE001 - any transport failure is a warning
            return None, f"could not be reached: {type(error).__name__}"
    return None, "could not be reached"


def cmd_leaks(args: argparse.Namespace) -> None:
    """Refuse to publish anything that describes the machine it was written on.

    The recordings have been held to this bar since they were introduced, and
    every other committed file was unchecked. This closes that half, and it runs
    on every push rather than once before the flip, because the file that leaks
    something is rarely the one anybody thought to look at.
    """
    # An exemption that outlives the file it was written for is a hole nobody
    # argued for, so renaming an exempt file has to fail rather than silently
    # exempt nothing.
    declared = {**LEAK_EXEMPT, **LEAK_BINARY}
    missing = [path for path in declared if not (ROOT / path).is_file()]
    if missing:
        sys.exit(
            "tse: these paths are exempt from the leak scan but no longer exist.\n"
            "     Either restore them or remove the exemption:\n"
            + "\n".join(f"       {path}  ({declared[path]})" for path in missing)
        )

    findings: list[str] = []
    unreadable: list[str] = []
    scanned = 0
    for path in tracked_files():
        if path in LEAK_EXEMPT:
            continue
        try:
            raw = (ROOT / path).read_bytes()
        except OSError as error:
            unreadable.append(f"{path}: could not be opened ({error.strerror})")
            continue
        text = decode_for_scanning(raw)
        if text is None:
            if path not in LEAK_BINARY:
                unreadable.append(f"{path}: is not text in any encoding this reads")
            continue
        scanned += 1
        for number, description, matched in scan_for_leaks(text, leak_patterns_for(path)):
            findings.append(f"{path}:{number}: {description}: {matched!r}")

    # A file the scanner could not read is not a file with nothing in it. This
    # used to be a `continue` and nothing else, so the count of files scanned
    # stayed where it was and the run said clean.
    if unreadable:
        print(f"{RED}tse: {len(unreadable)} tracked files the leak scan could not read:{OFF}\n")
        for entry in unreadable:
            print(f"  {entry}")
        print(
            f"\n{DIM}Nothing was checked in these. If a file is genuinely binary, "
            f"name it in LEAK_BINARY with the reason.{OFF}"
        )
        sys.exit(1)

    scope = f"{scanned} files"
    if args.history:
        findings += history_leaks()
        scope += " and the full history"

    if findings:
        print(f"{RED}tse: {len(findings)} things that should not be published:{OFF}\n")
        for finding in findings:
            print(f"  {finding}")
        print(
            f"\n{DIM}Each of these describes a real machine or a real credential. "
            f"Remove it, or narrow the rule if it is a false positive.{OFF}"
        )
        sys.exit(1)

    print(
        f"{GREEN}Leak scan clean.{OFF} {scope}, "
        f"{len(REPO_LEAK_PATTERNS)} patterns everywhere and "
        f"{len(TRANSCRIPT_LEAK_PATTERNS)} in recordings, "
        f"{len(LEAK_EXEMPT)} files exempt."
    )


def cmd_record(args: argparse.Namespace) -> None:
    """Capture real output for the site's terminal, or check a recording still holds.

    The terminal on the exercise page replays what these commands actually
    printed. That is only worth anything if the recording cannot drift away
    from the system, so --check re-runs everything and compares.
    """
    exercise = resolve(args.exercise)
    if exercise.stack == "none":
        sys.exit(f"tse: {exercise.id} has no system, so there is nothing to record.")

    source = exercise.path / "commands.txt"
    if not source.is_file():
        sys.exit(f"tse: {exercise.id} has no commands.txt")
    blocks = parse_commands(source.read_text())
    if not blocks:
        sys.exit(f"tse: {exercise.id} has an empty commands.txt")

    transcript_path = exercise.path / "transcript.json"
    previous: dict | None = None
    if args.check:
        if not transcript_path.is_file():
            sys.exit(f"tse: {exercise.id} has no transcript.json to check against")
        previous = json.loads(transcript_path.read_text())

    # Recorded commands run through `bash -c` exactly as a learner would type
    # them, which means a Kubernetes exercise runs against whatever context
    # happens to be current. Plenty of people have a production cluster in
    # their kubeconfig, so this refuses rather than pointing lab commands at
    # something real. tse's own calls always pass --context and were never at
    # risk; the commands in commands.txt are.
    if exercise.stack == "kind":
        current = subprocess.run(
            ["kubectl", "config", "current-context"], capture_output=True, text=True, encoding="utf-8",
        ).stdout.strip()
        if current != KIND_CONTEXT:
            sys.exit(
                f"tse: the current kubectl context is {current or 'unset'!r}, "
                f"not {KIND_CONTEXT!r}.\n"
                f"     Recorded commands run against the current context, so this "
                f"would capture\n     output from the wrong cluster. Switch with:\n"
                f"       kubectl config use-context {KIND_CONTEXT}"
            )

    foreign = foreign_projects()
    print(f"{BOLD}{exercise.id}{OFF}  {'checking' if args.check else 'recording'} "
          f"{len(blocks)} command(s)\n")

    entries: list[dict] = []
    problems: list[str] = []
    missing: dict[str, list[str]] = {}
    try:
        provision(exercise, variant="setup")
        for block in blocks:
            if block["wait"]:
                time.sleep(block["wait"])
            captured, code = run_for_record(block["command"])
            if block["until"]:
                deadline = time.monotonic() + UNTIL_TIMEOUT_S
                while (block["until"] not in captured
                       and time.monotonic() < deadline):
                    time.sleep(UNTIL_DELAY_S)
                    captured, code = run_for_record(block["command"])
            label = normalize_command(block["command"])[:70]

            # Store the scrubbed form, not what was captured.
            #
            # These files are committed and published. Raw output carries the
            # ids, addresses and clock of the machine that happened to run the
            # recording, and none of that belongs to the course. Scrubbing at
            # write time means the values that differ per machine are shown as
            # placeholders, which is also more honest for the reader: it marks
            # exactly which parts of the output are theirs rather than mine.
            output = scrub(captured, privacy_only=True)

            leaked = private_leaks(output, foreign)
            if leaked:
                problems.append(
                    f"{label}\n      names something outside the lab: {leaked}.\n"
                    f"      Scope the command, for example filter by the compose "
                    f"project, so the recording contains only this exercise."
                )
                continue

            entry = {
                "command": block["command"],
                "aliases": block["aliases"],
                "match": match_keys(block["command"], block["aliases"]),
                "output": output,
                "exit": code,
            }
            entry_missing = [m for m in block["keep"] if m not in output]
            entries.append(entry)
            missing[block["command"]] = entry_missing
            if entry_missing:
                print(f"  {RED}lost{OFF}  {label}")
            else:
                print(f"  {GREEN}ok{OFF}    {label}")
    finally:
        teardown(exercise)

    if problems:
        print(f"\n{RED}{len(problems)} command(s) cannot be recorded:{OFF}")
        for problem in problems:
            print(f"  {problem}")
        sys.exit(1)

    if args.check:
        # Compare before diagnosing missing markers. A changed system and an
        # over-broad scrub rule both lose a marker, and only the comparison
        # tells them apart. Reporting "a rule is too broad" when the truth is
        # "the system changed" sends the reader to the wrong file.
        drifted = compare_transcript(previous or {}, entries)
        if drifted:
            print(f"\n{RED}The recording no longer matches the system.{OFF}")
            for line in drifted:
                print(f"  {line}")
            print(f"\nRe-record with `tse record {exercise.id}` once you have "
                  f"confirmed the change is intended.")
            sys.exit(1)
        if any(missing.values()):
            print(f"\n{RED}The output is unchanged, so a scrub rule has grown "
                  f"too broad and is erasing evidence:{OFF}")
            for command, markers in missing.items():
                if markers:
                    print(f"  {normalize_command(command)[:70]}\n      lost {markers}")
            sys.exit(1)
        print(f"\n{GREEN}{exercise.id}: the recording still matches.{OFF}")
        return

    if any(missing.values()):
        print(f"\n{RED}Evidence did not survive scrubbing:{OFF}")
        for command, markers in missing.items():
            if markers:
                print(f"  {normalize_command(command)[:70]}\n      lost {markers}")
        print("\nEither the system is not in the state the exercise describes, "
              "or a scrub rule is too broad.")
        sys.exit(1)

    if len(entries) < 4:
        print(f"\n{YELLOW}Only {len(entries)} command(s) recorded.{OFF} A thin "
              f"transcript makes the terminal frustrating rather than useful.")

    transcript_path.write_text(
        json.dumps({"recorded": date.today().isoformat(), "entries": entries}, indent=2) + "\n"
    )
    print(f"\n{GREEN}Wrote {transcript_path.relative_to(ROOT)}{OFF}")


# curl carries the same information in its exit status as in its message, so
# folding one without the other leaves the comparison failing on the half that
# was missed. 52 is a connection closed cleanly with nothing sent and 56 is the
# same connection reset, which is decided by the host rather than by the lab.
#
# Scoped to commands that actually run curl, because these numbers mean nothing
# in particular anywhere else. 7, a refused connection, is deliberately absent:
# see the curl-accepted-then-nothing scrub rule for why that distinction has to
# survive.
CURL_EQUIVALENT_EXITS = frozenset({52, 56})


def exits_agree(command: str, before: object, after: object) -> bool:
    if before == after:
        return True
    if not re.search(r"\bcurl\b", command):
        return False
    return {before, after} <= CURL_EQUIVALENT_EXITS


def compare_transcript(previous: dict, fresh: list[dict]) -> list[str]:
    """Differences that survive scrubbing, which are the ones that mean something."""
    before = previous.get("entries", [])
    if len(before) != len(fresh):
        return [f"the recording has {len(before)} command(s), the run produced {len(fresh)}"]

    differences: list[str] = []
    for old, new in zip(before, fresh):
        label = normalize_command(new["command"])[:70]
        if normalize_command(old.get("command", "")) != normalize_command(new["command"]):
            differences.append(f"{label}\n      commands.txt changed since the recording")
            continue
        # The site looks a typed command up against `match`, so an alias added
        # to commands.txt without re-recording is a command that silently does
        # nothing on the page. Nothing else would notice: the output is
        # identical, and it is the lookup key that went stale.
        if old.get("match") != new["match"]:
            differences.append(
                f"{label}\n      the spellings in commands.txt changed since the "
                f"recording:\n        recorded: {old.get('match')}\n        now:      {new['match']}"
            )
        if not exits_agree(new["command"], old.get("exit"), new["exit"]):
            differences.append(
                f"{label}\n      exited {new['exit']}, the recording has {old.get('exit')}"
            )
        if scrub(old.get("output", "")) != scrub(new["output"]):
            differences.append(f"{label}\n      output changed" + first_difference(
                scrub(old.get("output", "")), scrub(new["output"])
            ))
    return differences


def first_difference(before: str, after: str) -> str:
    """The first line that differs, which is usually enough to see what moved."""
    old_lines, new_lines = before.split("\n"), after.split("\n")
    for index in range(max(len(old_lines), len(new_lines))):
        old = old_lines[index] if index < len(old_lines) else "<nothing>"
        new = new_lines[index] if index < len(new_lines) else "<nothing>"
        if old != new:
            return f" at line {index + 1}:\n        recorded: {old}\n        now:      {new}"
    return ""


def cmd_apply(args: argparse.Namespace) -> None:
    """Recreate the services from the learner's edited configuration."""
    exercise = current_exercise()
    if exercise.stack == "none":
        sys.exit(
            "tse: this exercise has no system to apply to.\n"
            "     Edit the file named in the ticket, then run `tse check`."
        )
    if exercise.stack == "kind":
        sys.exit(
            "tse: the Kubernetes track has no apply step.\n"
            "     Change the cluster directly, the way you would in production:\n"
            f"       kubectl -n {LAB_NAMESPACE} edit deployment/<name>\n"
            f"       kubectl -n {LAB_NAMESPACE} set image ...\n"
            "     Then run `tse check`."
        )
    if exercise.stack != "compose":
        sys.exit(f"tse: apply is not used by the {exercise.stack!r} stack")
    run(compose_command(exercise) + ["up", "-d", "--build", "--force-recreate"])
    print(f"\n{DIM}Applied. Now prove it worked with `tse check`.{OFF}")


def cmd_reset(args: argparse.Namespace) -> None:
    exercise = current_exercise()
    print(f"Resetting {exercise.id} ...")
    provision(exercise, variant="setup")
    state = read_state()
    state.setdefault("hints", {})[exercise.id] = 0
    write_state(state)
    print("Back to the state described in the ticket.")


def cmd_stop(args: argparse.Namespace) -> None:
    exercise = current_exercise()
    teardown(exercise)
    state = read_state()
    state["current"] = None
    write_state(state)
    print(f"Stopped {exercise.id}.")


def cmd_cluster(args: argparse.Namespace) -> None:
    if args.action == "up":
        ensure_cluster()
        print(f"{GREEN}Cluster {KIND_CLUSTER} is ready.{OFF}")
    elif args.action == "down":
        if not cluster_exists():
            print(f"Cluster {KIND_CLUSTER} does not exist.")
            return
        run(["kind", "delete", "cluster", "--name", KIND_CLUSTER])
    else:
        if not cluster_exists():
            print(f"Cluster {KIND_CLUSTER} does not exist. Create it with `tse cluster up`.")
            return
        print(f"{GREEN}Cluster {KIND_CLUSTER} exists.{OFF}")
        platform = node_platform()
        for image in KIND_IMAGES:
            state = "preloaded" if image_in_node(image) else "will be pulled on use"
            print(f"  {image:<24} {state}")
        print(f"  node platform            {platform or 'unknown'}\n")
        subprocess.run(kubectl("get", "nodes"), check=False)
        subprocess.run(kubectl("get", "all", "-n", LAB_NAMESPACE), check=False)


def cmd_progress(args: argparse.Namespace) -> None:
    state = read_state()
    exercises = load_exercises()
    completed = set(state.get("completed", []))
    payload = {
        "completed": sorted(completed),
        "total": len(exercises),
        "by_track": {},
    }
    for exercise in exercises:
        bucket = payload["by_track"].setdefault(exercise.track, {"done": 0, "total": 0})
        bucket["total"] += 1
        if exercise.id in completed:
            bucket["done"] += 1

    if args.json:
        print(json.dumps(payload, indent=2))
        return

    for track, counts in payload["by_track"].items():
        bar_width = 24
        filled = round(bar_width * counts["done"] / counts["total"]) if counts["total"] else 0
        bar = "#" * filled + "." * (bar_width - filled)
        print(f"  {track:<16} {bar}  {counts['done']}/{counts['total']}")
    print(f"\n  {BOLD}{len(completed)}/{len(exercises)}{OFF} overall")
    print(f"\n{DIM}Export for the site with `tse progress --json`.{OFF}")


def cmd_doctor(args: argparse.Namespace) -> None:
    checks: list[tuple[str, bool, str]] = []

    def probe(label: str, command: list[str], remedy: str) -> None:
        binary = shutil.which(command[0])
        if not binary:
            checks.append((label, False, remedy))
            return
        result = subprocess.run(command, capture_output=True, text=True, encoding="utf-8")
        detail = (result.stdout or result.stderr).strip().splitlines()
        checks.append((label, result.returncode == 0, detail[0] if detail else ""))

    probe("docker", ["docker", "--version"], "Install Docker, or open this repo in a Codespace.")
    probe("docker compose", ["docker", "compose", "version"], "Docker Compose v2 is required.")
    probe("docker daemon", ["docker", "info", "--format", "{{.ServerVersion}}"], "Start Docker.")
    probe("kubectl", ["kubectl", "version", "--client=true", "-o", "yaml"], "Needed for the Kubernetes track.")
    probe("kind", ["kind", "version"], "Needed for the Kubernetes track.")
    probe("curl", ["curl", "--version"], "Needed by most checks.")
    probe("jq", ["jq", "--version"], "Needed by the API and observability tracks.")
    # Not needed to run a lab, and needed to get a change merged. CI lints every
    # shell script in the repository and nothing said so anywhere: not here, not
    # in CONTRIBUTING, not in the devcontainer. The first a contributor heard of
    # it was a red build on work that passed on their own machine.
    probe("shellcheck", ["shellcheck", "--version"],
          "Only needed to contribute. CI lints every shell script with it.")

    cpus = os.cpu_count() or 1
    checks.append((
        f"cpu cores ({cpus})",
        cpus >= 4,
        "The Kubernetes track needs 4 cores. Use a 4-core Codespace." if cpus < 4 else "",
    ))

    width = max(len(label) for label, _, _ in checks)
    failures = 0
    for label, ok, detail in checks:
        if ok:
            print(f"  {GREEN}ok{OFF}    {label:<{width}}  {DIM}{detail}{OFF}")
        else:
            failures += 1
            print(f"  {RED}warn{OFF}  {label:<{width}}  {detail}")

    print()
    if failures:
        print(f"{YELLOW}{failures} check(s) need attention.{OFF} "
              "Docker tracks work as long as docker and curl are ok.")
    else:
        print(f"{GREEN}Environment ready.{OFF} Start with `tse start docker/01`.")


def run_check(exercise: Exercise, *, max_retries: int | None = None) -> int:
    env = os.environ.copy()
    env.update(
        TSE_ROOT=str(ROOT),
        TSE_LIB=str(LIB),
        TSE_EXERCISE_DIR=str(exercise.path),
        TSE_STACK_DIR=str(exercise.stack_dir()),
    )
    if max_retries is not None:
        env["TSE_MAX_RETRIES"] = str(max_retries)
    sys.stdout.flush()
    return subprocess.run(["bash", str(exercise.path / "check.sh")], env=env).returncode


def verify_one(exercise: Exercise) -> bool:
    """An exercise is only correct if it fails broken and passes fixed."""
    print(f"\n{BOLD}=== {exercise.id} ==={OFF}\n")
    ok = True
    try:
        print(f"{DIM}-- broken state: check must fail --{OFF}\n")
        provision(exercise, variant="setup")
        if run_check(exercise, max_retries=3) == 0:
            print(f"{RED}BROKEN STATE PASSED.{OFF} The exercise is not actually broken, "
                  f"or check.sh does not assert the failure.")
            ok = False

        print(f"\n{DIM}-- fixed state: check must pass --{OFF}\n")
        provision(exercise, variant="solution")
        if run_check(exercise) != 0:
            print(f"{RED}FIXED STATE FAILED.{OFF} The documented solution does not "
                  f"satisfy check.sh.")
            ok = False
    finally:
        teardown(exercise)

    print(f"\n{GREEN if ok else RED}{exercise.id}: {'verified' if ok else 'INVALID'}{OFF}")
    return ok


def cmd_verify(args: argparse.Namespace) -> None:
    if args.exercise:
        targets = [resolve(args.exercise)]
    else:
        # Every exercise is verifiable, including the ones with no system.
        # A communication exercise still has a broken draft that must fail
        # the rubric and a good one that must pass it.
        targets = load_exercises()

    failed = [e.id for e in targets if not verify_one(e)]

    print()
    if failed:
        print(f"{RED}{len(failed)} exercise(s) invalid:{OFF}")
        for exercise_id in failed:
            print(f"  {exercise_id}")
        sys.exit(1)
    print(f"{GREEN}All {len(targets)} exercise(s) verified.{OFF}")


def cmd_new(args: argparse.Namespace) -> None:
    try:
        track, slug = args.exercise.split("/", 1)
    except ValueError:
        sys.exit("tse: expected <track>/<slug>, for example `tse new docker/04-port-mapping`")

    destination = LABS / track / slug
    if destination.exists():
        sys.exit(f"tse: {destination.relative_to(ROOT)} already exists")
    if not (TEMPLATES / "exercise").is_dir():
        sys.exit("tse: tools/templates/exercise is missing")

    shutil.copytree(TEMPLATES / "exercise", destination)
    meta_path = destination / "meta.yaml"
    meta_path.write_text(
        meta_path.read_text()
        .replace("{{TRACK}}", track)
        .replace("{{SLUG}}", slug)
    )
    (destination / "check.sh").chmod(0o755)
    print(f"Created {destination.relative_to(ROOT)}")
    print("Next: write ticket.md as a symptom only, then setup/, check.sh, hints/, solution.md")


def main() -> None:
    parser = argparse.ArgumentParser(prog="tse", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("list", help="show every exercise and your progress")
    p.add_argument("--track", help="limit to one track")
    p.add_argument("--ids", action="store_true", help="emit a JSON array of ids for CI")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser(
        "affected",
        help="read changed paths on stdin, emit the exercise ids CI has to verify",
    )
    p.add_argument("--by-stack", action="store_true",
                   help="group them by the stack each runs against, for the CI matrix")
    p.add_argument("--for-github", action="store_true",
                   help="write the matrix to $GITHUB_OUTPUT and print a summary")
    p.set_defaults(func=cmd_affected)

    p = sub.add_parser("verify", help="assert an exercise fails broken and passes fixed")
    p.add_argument("exercise", nargs="?", help="omit to verify every exercise")
    p.set_defaults(func=cmd_verify)

    p = sub.add_parser("start", help="provision an exercise and print its ticket")
    p.add_argument("exercise")
    p.set_defaults(func=cmd_start)

    p = sub.add_parser("ticket", help="reprint the active ticket")
    p.set_defaults(func=cmd_ticket)

    p = sub.add_parser("check", help="grade the active exercise, showing the evidence used")
    p.add_argument("exercise", nargs="?")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("hint", help="reveal the next hint")
    p.set_defaults(func=cmd_hint)

    p = sub.add_parser("answer", help="reveal the root cause and the customer wording")
    p.set_defaults(func=cmd_answer)

    p = sub.add_parser("quiz", help="answer the exercise's questions and see why")
    p.add_argument("exercise", nargs="?")
    p.set_defaults(func=cmd_quiz)

    p = sub.add_parser("record", help="capture real output for the site's terminal")
    p.add_argument("exercise")
    p.add_argument("--check", action="store_true",
                   help="re-run and assert the recording still matches the system")
    p.set_defaults(func=cmd_record)

    p = sub.add_parser("links", help="check that every link in the repository resolves")
    p.add_argument("--offline", action="store_true",
                   help="skip external links and check only what is on disk")
    p.set_defaults(func=cmd_links)

    p = sub.add_parser("leaks", help="scan committed files for anything from a real machine")
    p.add_argument("--history", action="store_true",
                   help="also scan every line this repository has ever added")
    p.set_defaults(func=cmd_leaks)

    p = sub.add_parser("apply", help="recreate the services after you edit the configuration")
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("reset", help="return to the state described in the ticket")
    p.set_defaults(func=cmd_reset)

    p = sub.add_parser("stop", help="tear down the active exercise")
    p.set_defaults(func=cmd_stop)

    p = sub.add_parser("progress", help="show or export progress")
    p.add_argument("--json", action="store_true", help="emit JSON for the site to import")
    p.set_defaults(func=cmd_progress)

    p = sub.add_parser("cluster", help="manage the shared Kubernetes lab cluster")
    p.add_argument("action", choices=["up", "down", "status"], nargs="?", default="status")
    p.set_defaults(func=cmd_cluster)

    p = sub.add_parser("doctor", help="verify this machine can run the labs")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("new", help="scaffold a new exercise from the template")
    p.add_argument("exercise", help="<track>/<slug>")
    p.set_defaults(func=cmd_new)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
