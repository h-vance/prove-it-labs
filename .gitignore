# Learner progress, local to each machine.
.tse-state.json

# Per-machine editor and agent settings. This was only ever ignored by one
# person's global gitignore, which is not a property of this repository:
# anybody cloning it without that file would see their own local settings as
# untracked and could commit them. `.claude/launch.json` is deliberately not
# here, because the dev server command is shared and carries nothing personal.
.claude/settings.local.json
.vscode/settings.json
.idea/

# Generated by `tse start`: the live state of the exercise you are working on.
# Every filename an exercise writes into a shared _stack belongs here.
# test_content.py fails the build if one is missing.
labs/*/_stack/compose.override.yaml
labs/*/_stack/request.sh
labs/*/_stack/query.sql
labs/*/_stack/tenants.json

# Site build output.
site/node_modules/
site/dist/
site/.astro/

__pycache__/
*.pyc
.DS_Store

# Communication track: the written answer, materialized into its own stack.
labs/*/_stack/customer-update.md
labs/*/_stack/escalation.md
labs/*/_stack/evidence.md
