---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { loadExercises, difficultyLabel, type Exercise } from "../../../lib/labs";
import ScratchPad from "../../../components/ScratchPad";
import Quiz from "../../../components/Quiz";
import LabTerminal from "../../../components/LabTerminal";

export function getStaticPaths() {
  return loadExercises().map((exercise) => ({
    params: { track: exercise.track, slug: exercise.slug },
    props: { exercise },
  }));
}

interface Props {
  exercise: Exercise;
}

const { exercise } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const all = loadExercises();
const prerequisites = exercise.prerequisites
  .map((id) => all.find((candidate) => candidate.id === id))
  .filter((candidate): candidate is Exercise => Boolean(candidate));
const difficulty = difficultyLabel(exercise.difficulty);

// StarlightPage builds its table of contents from this list rather than by
// scanning the slot, so the sections rendered by the islands have to be
// declared here or they vanish from the sidebar navigation.
const headings = [
  { depth: 2, slug: "start-it", text: "Start it" },
  { depth: 2, slug: "the-ticket", text: "The ticket" },
  ...(exercise.transcript.length > 0
    ? [{ depth: 2, slug: `terminal-${exercise.id}`, text: "Look at the evidence" }]
    : []),
  { depth: 2, slug: `pad-${exercise.id}`, text: "Investigation scratchpad" },
  { depth: 2, slug: `hints-${exercise.id}`, text: "Hints" },
  { depth: 2, slug: `solution-${exercise.id}`, text: "Solution" },
  ...(exercise.questions.length > 0
    ? [{ depth: 2, slug: `quiz-${exercise.id}`, text: "Check your understanding" }]
    : []),
  { depth: 2, slug: "why-this-one-exists", text: "Why this one exists" },
];
---

<StarlightPage
  frontmatter={{
    title: exercise.title,
    description: exercise.proofQuestion,
    tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 },
  }}
  headings={headings}
>
  <p class="proof-question">{exercise.proofQuestion}</p>

  <dl class="facts">
    <div>
      <dt>Track</dt>
      <dd>{exercise.trackLabel}</dd>
    </div>
    <div>
      <dt>Time</dt>
      <dd>about {exercise.minutes} minutes</dd>
    </div>
    <div>
      <dt>Difficulty</dt>
      <dd>{difficulty}</dd>
    </div>
    <div>
      <dt>Tier</dt>
      <dd>{exercise.tier === "core" ? "Core" : "Stretch"}</dd>
    </div>
  </dl>

  {
    prerequisites.length > 0 && (
      <p class="prereq">
        Do these first:{" "}
        {prerequisites.map((prerequisite, index) => (
          <>
            {index > 0 && ", "}
            <a href={`${base}${prerequisite.href}`}>{prerequisite.title}</a>
          </>
        ))}
      </p>
    )
  }

  <h2 id="start-it">Start it</h2>
  <p>In a Codespace or a local clone:</p>
  <pre tabindex="0"><code>tse start {exercise.id}</code></pre>
  <p>
    That provisions the broken system and prints the ticket below. Investigate with
    ordinary tools, then run <code>tse check</code>.
  </p>

  <h2 id="the-ticket">The ticket</h2>
  <div class="ticket" set:html={exercise.ticketHtml} />

  {/*
    client:load rather than client:visible on all three. The scratchpad is a
    real textarea before it hydrates, so a learner can start typing into it and
    have hydration replace what they wrote with stored state. Losing someone's
    written investigation to save a few kilobytes is not a trade worth making,
    and the hints and solution are the point of the page rather than an
    enhancement to it.
  */}
  {/*
    Investigation comes before notes, so the terminal sits between the ticket
    and the scratchpad rather than after it.
  */}
  <LabTerminal exerciseId={exercise.id} entries={exercise.transcript} client:load />

  <ScratchPad exerciseId={exercise.id} client:load />

  {/*
    Hints and the solution are written into the page, not handed to an island.

    They used to be props on a Preact component, which meant the markup shipped
    in every page escaped inside an attribute: the bytes were paid for on every
    visit and nobody with JavaScript off could read a word of it. Worst of both.

    A native `<details>` opens and closes with no script at all and carries the
    disclosure semantics for free, so the content is now genuinely available.
    The script below only adds what the browser cannot: remembering what was
    open, and holding the hints in order.
  */}
  {
    exercise.hintsHtml.length > 0 && (
      <section class="reveal" aria-labelledby={`hints-${exercise.id}`} data-hints>
        <h2 id={`hints-${exercise.id}`}>Hints</h2>
        <p class="reveal__lede">
          Each hint gives away a little more. Try to spend a few minutes on your
          own evidence first, because the recall is what makes it stick.
        </p>
        {exercise.hintsHtml.map((html, index) => (
          <details
            class="reveal__disclosure"
            data-hint={index}
            data-key={`proveit:hint:${exercise.id}:${index}`}
            data-progress-key={`proveit:hints:${exercise.id}`}
          >
            <summary>
              Hint {index + 1}
              <span class="reveal__of"> of {exercise.hintsHtml.length}</span>
            </summary>
            <div class="reveal__item" set:html={html} />
          </details>
        ))}
      </section>
    )
  }

  {
    exercise.solutionHtml && (
      <section class="reveal" aria-labelledby={`solution-${exercise.id}`}>
        <h2 id={`solution-${exercise.id}`}>Solution</h2>
        <p class="reveal__lede">
          Write your customer update before you read this. Comparing your wording
          against the model answer is worth more than reading it cold.
        </p>
        <details
          class="reveal__disclosure"
          data-solution
          data-key={`proveit:solution:${exercise.id}`}
        >
          <summary>Reveal the solution</summary>
          <div class="reveal__item" set:html={exercise.solutionHtml} />
        </details>
      </section>
    )
  }

  <Quiz exerciseId={exercise.id} questions={exercise.questions} client:load />

  <h2 id="why-this-one-exists">Why this one exists</h2>
  {exercise.teaches && <p>{exercise.teaches}</p>}
  {
    exercise.interviewRelevance && (
      <>
        <h3>In an interview</h3>
        <p>{exercise.interviewRelevance}</p>
      </>
    )
  }

  {
    exercise.commandsIntroduced.length > 0 && (
      <>
        <h3>Commands introduced</h3>
        <ul class="chips">
          {exercise.commandsIntroduced.map((command) => (
            <li><code>{command}</code></li>
          ))}
        </ul>
      </>
    )
  }

  {
    exercise.evidenceLayers.length > 0 && (
      <>
        <h3>Evidence layers</h3>
        <ul class="chips">
          {exercise.evidenceLayers.map((layer) => (
            <li>{layer}</li>
          ))}
        </ul>
      </>
    )
  }
</StarlightPage>

{/*
  Everything the browser cannot do on its own, and nothing it can.

  The disclosures above work with no script: opening and closing, the keyboard,
  and the accessibility tree are all native. This adds two things.

  It remembers what was open, under the same storage keys the islands used, so
  nobody who already has a place in a page loses it.

  And it keeps the hints in order, which is the one thing the markup cannot
  express. Later hints are folded away until the one before has been opened.
  With scripting off they are all available, which is the right way round: the
  enhancement adds restraint, and its absence never withholds content. The
  solution says the same thing in its own words already, that the click is
  there to stop somebody reading the answer by accident rather than to gate it.
*/}
<script>
  function remember(node: HTMLDetailsElement) {
    const key = node.dataset.key;
    if (!key) return;
    try {
      if (localStorage.getItem(key) === "true") node.open = true;
    } catch {
      /* Private mode or storage disabled. The page works, it just forgets. */
    }
    node.addEventListener("toggle", () => {
      try {
        localStorage.setItem(key, String(node.open));
      } catch {
        /* As above. Never let a storage failure break the disclosure. */
      }
    });
  }

  const solution = document.querySelector<HTMLDetailsElement>("details[data-solution]");
  if (solution) remember(solution);

  const hints = [...document.querySelectorAll<HTMLDetailsElement>("details[data-hint]")];
  const first = hints[0];
  if (first) {
    const progressKey = first.dataset.progressKey ?? "";

    // How far the learner has already got, so returning to a page does not
    // fold away hints they have already read.
    let unlocked = 1;
    try {
      unlocked = Math.max(1, Number(localStorage.getItem(progressKey) ?? 1));
    } catch {
      /* Defaults are fine. */
    }

    const apply = () => hints.forEach((hint, index) => (hint.hidden = index >= unlocked));

    hints.forEach((hint, index) => {
      remember(hint);
      hint.addEventListener("toggle", () => {
        if (!hint.open || index + 1 < unlocked) return;
        unlocked = index + 2;
        try {
          localStorage.setItem(progressKey, String(unlocked));
        } catch {
          /* As above. */
        }
        apply();
      });
    });

    apply();
  }
</script>
